<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>模型输出管家 v4.0</title>
<style>
  @font-face {
    font-family: "HubWenKaiBold";
    src: local("LXGWWenKaiMonoBold"), local("霞鹜文楷等宽粗体"), url("https://hub.local/fonts/wenkai-bold.ttf") format("truetype");
    font-weight: 400 700;
    font-display: block;
  }
  @font-face {
    font-family: "HubWenKaiXBold";
    src: local("LXGWWenKaiMonoXBold"), local("霞鹜文楷等宽特粗"), url("https://hub.local/fonts/wenkai-xbold.ttf") format("truetype");
    font-weight: 400 900;
    font-display: block;
  }
  @font-face {
    font-family: "HubWenKaiReg";
    src: local("LXGW WenKai"), local("霞鹜文楷"), url("https://hub.local/fonts/wenkai-reg.ttf") format("truetype");
    font-weight: 400;
    font-display: block;
  }

  :root {
    --font-serif: "Noto Serif SC", "Songti SC", "Georgia", serif;
    --font-sans: "Noto Sans SC", "Microsoft YaHei UI", "Segoe UI", sans-serif;
    --font-wenkai: "HubWenKaiReg", "LXGW WenKai", "Noto Serif SC", serif;
    --display-font: var(--font-serif);

    --fs-body: 14.5px;
    --fs-sub: 14px;
    --fs-tag: 12.5px;
    --fs-h3: 17px;
    --fs-h2: 22px;

    /* =========================================================
       DEFAULT PRIMARY: Peach Amber Jelly (蜜桃琥珀果冻 · 方向 B)
       ========================================================= */
    --bg-canvas: #FFE4D6;
    --bg-surface: rgba(255, 240, 232, 0.62);
    --bg-surface-solid: #FFF5EF;
    --bg-elevated: rgba(255, 218, 200, 0.62);
    --bg-hover: rgba(255, 202, 178, 0.50);
    --ink-1: #2F150E;
    --ink-2: #54291E;
    --ink-3: #683629;
    --line-soft: rgba(214, 148, 122, 0.30);
    --line-strong: rgba(196, 114, 86, 0.48);

    --accent: #C73A22;
    --accent-ink: #FFFFFF;
    --accent-grad: linear-gradient(180deg, #E45E43 0%, #C73A22 100%);
    --accent-soft: rgba(214, 72, 46, 0.13);
    --accent-glow: 0 7px 18px -4px rgba(199, 58, 34, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.34);
    --fresh-ink: #B2301A;

    --diff-bg: linear-gradient(135deg, rgba(255, 248, 232, 0.84) 0%, rgba(255, 228, 202, 0.68) 100%);
    --diff-border: rgba(226, 140, 82, 0.46);
    --diff-ink: #5A2610;
    --diff-badge-bg: #C73A22;
    --diff-badge-ink: #FFFFFF;

    --live-color: #C73A22;
    --live-soft: rgba(214, 72, 46, 0.18);
    --archive-ring: #965D48;

    --jelly-island-bg: linear-gradient(155deg, rgba(255, 244, 238, 0.60) 0%, rgba(255, 214, 194, 0.44) 100%);
    --jelly-card-bg: linear-gradient(165deg, rgba(255, 252, 249, 0.80) 0%, rgba(255, 228, 212, 0.56) 100%);
    --jelly-pill-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 232, 220, 0.66) 100%);
    --jelly-rim: rgba(255, 255, 255, 0.88);
    --jelly-shadow: 0 18px 42px -12px rgba(154, 58, 32, 0.13), 0 3px 10px -2px rgba(154, 58, 32, 0.05), inset 0 1.5px 0 rgba(255, 255, 255, 0.92), inset 0 -3px 10px rgba(255, 146, 112, 0.16);
    --card-shadow: 0 8px 22px -8px rgba(154, 58, 32, 0.11), 0 2px 5px rgba(154, 58, 32, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.94);
    --pill-shadow: 0 3px 9px -2px rgba(154, 58, 32, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.92);

    --tag-bg: #C73A22;
    --tag-grad: linear-gradient(180deg, #E25B40 0%, #C73A22 100%);
    --tag-ink: #FFFFFF;
    --tag-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.36), 0 3px 8px rgba(199, 58, 34, 0.24);

    --orb-1: rgba(255, 114, 82, 0.64);
    --orb-2: rgba(255, 182, 82, 0.56);
    --orb-3: rgba(255, 122, 168, 0.50);
    --orb-4: rgba(255, 154, 114, 0.52);

    --radius-island: 24px;
    --radius-lg: 18px;
    --radius-md: 14px;
    --radius-sm: 10px;
    --radius-pill: 999px;
    --is-dark: 0;
  }

  /* =========================================================
     Theme 2: Alabaster White Jade Jelly (凝脂白玉果冻 · 偏白浅色)
     ========================================================= */
  body[data-paradigm="alabaster"] {
    --bg-canvas: #F8F9FB;
    --bg-surface: rgba(255, 255, 255, 0.64);
    --bg-surface-solid: #FFFFFF;
    --bg-elevated: rgba(238, 241, 247, 0.70);
    --bg-hover: rgba(226, 232, 242, 0.58);
    --ink-1: #141923;
    --ink-2: #2D3648;
    --ink-3: #4B576E;
    --line-soft: rgba(154, 166, 188, 0.28);
    --line-strong: rgba(114, 130, 158, 0.46);

    --accent: #223B61;
    --accent-ink: #FFFFFF;
    --accent-grad: linear-gradient(180deg, #355482 0%, #223B61 100%);
    --accent-soft: rgba(34, 59, 97, 0.10);
    --accent-glow: 0 7px 18px -4px rgba(34, 59, 97, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.30);
    --fresh-ink: #1F3E6E;

    --diff-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.90) 0%, rgba(242, 245, 250, 0.78) 100%);
    --diff-border: rgba(124, 146, 180, 0.38);
    --diff-ink: #1A2B46;
    --diff-badge-bg: #223B61;
    --diff-badge-ink: #FFFFFF;

    --live-color: #C23C32;
    --live-soft: rgba(194, 60, 50, 0.16);
    --archive-ring: #4B5F80;

    --jelly-island-bg: linear-gradient(155deg, rgba(255, 255, 255, 0.64) 0%, rgba(244, 246, 250, 0.50) 100%);
    --jelly-card-bg: linear-gradient(165deg, rgba(255, 255, 255, 0.86) 0%, rgba(246, 248, 252, 0.68) 100%);
    --jelly-pill-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(242, 245, 250, 0.76) 100%);
    --jelly-rim: rgba(255, 255, 255, 0.96);
    --jelly-shadow: 0 18px 42px -12px rgba(32, 46, 74, 0.09), 0 3px 10px -2px rgba(32, 46, 74, 0.04), inset 0 1.5px 0 rgba(255, 255, 255, 1), inset 0 -3px 10px rgba(186, 198, 218, 0.16);
    --card-shadow: 0 8px 20px -8px rgba(32, 46, 74, 0.08), 0 2px 5px rgba(32, 46, 74, 0.04), inset 0 1px 0 rgba(255, 255, 255, 1);
    --pill-shadow: 0 3px 9px -2px rgba(32, 46, 74, 0.07), inset 0 1px 0 rgba(255, 255, 255, 1);

    --tag-bg: #223B61;
    --tag-grad: linear-gradient(180deg, #355482 0%, #223B61 100%);
    --tag-ink: #FFFFFF;
    --tag-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), 0 3px 8px rgba(34, 59, 97, 0.20);

    --orb-1: rgba(206, 218, 238, 0.48);
    --orb-2: rgba(232, 224, 214, 0.50);
    --orb-3: rgba(212, 226, 232, 0.42);
    --orb-4: rgba(226, 224, 240, 0.40);
    --is-dark: 0;
  }

  /* =========================================================
     Theme 3: Obsidian Ink Crystal (黑曜墨晶果冻 · 偏黑深色)
     ========================================================= */
  body[data-paradigm="obsidian"] {
    --bg-canvas: #0A0C10;
    --bg-surface: rgba(26, 30, 38, 0.64);
    --bg-surface-solid: #151820;
    --bg-elevated: rgba(40, 46, 58, 0.68);
    --bg-hover: rgba(56, 64, 80, 0.60);
    --ink-1: #F5F7FB;
    --ink-2: #DCE2EE;
    --ink-3: #B4BFCF;
    --line-soft: rgba(182, 196, 222, 0.18);
    --line-strong: rgba(210, 222, 244, 0.34);

    --accent: #2C67CA;
    --accent-ink: #FFFFFF;
    --accent-grad: linear-gradient(180deg, #4B88EE 0%, #2C67CA 100%);
    --accent-soft: rgba(95, 155, 255, 0.18);
    --accent-glow: 0 7px 20px -4px rgba(44, 103, 202, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    --fresh-ink: #94C6FF;

    --diff-bg: linear-gradient(135deg, rgba(48, 42, 32, 0.80) 0%, rgba(28, 32, 42, 0.72) 100%);
    --diff-border: rgba(238, 182, 102, 0.38);
    --diff-ink: #F9DCAA;
    --diff-badge-bg: #2C67CA;
    --diff-badge-ink: #FFFFFF;

    --live-color: #FF8A7A;
    --live-soft: rgba(255, 138, 122, 0.22);
    --archive-ring: #8AA0C4;

    --jelly-island-bg: linear-gradient(155deg, rgba(30, 34, 44, 0.66) 0%, rgba(16, 19, 25, 0.56) 100%);
    --jelly-card-bg: linear-gradient(165deg, rgba(40, 45, 56, 0.74) 0%, rgba(24, 28, 36, 0.64) 100%);
    --jelly-pill-bg: linear-gradient(180deg, rgba(50, 56, 70, 0.80) 0%, rgba(32, 36, 46, 0.70) 100%);
    --jelly-rim: rgba(255, 255, 255, 0.15);
    --jelly-shadow: 0 22px 48px -10px rgba(0, 0, 0, 0.72), 0 4px 14px rgba(0, 0, 0, 0.44), inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 0 -3px 10px rgba(110, 140, 190, 0.10);
    --card-shadow: 0 10px 26px -8px rgba(0, 0, 0, 0.54), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    --pill-shadow: 0 3px 9px -2px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.14);

    --tag-bg: #2C67CA;
    --tag-grad: linear-gradient(180deg, #4B88EE 0%, #2C67CA 100%);
    --tag-ink: #FFFFFF;
    --tag-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 3px 8px rgba(12, 34, 82, 0.42);

    --orb-1: rgba(70, 114, 186, 0.34);
    --orb-2: rgba(54, 86, 148, 0.26);
    --orb-3: rgba(154, 116, 72, 0.22);
    --orb-4: rgba(116, 134, 168, 0.22);
    --is-dark: 1;
  }

  /* =========================================================
     Theme 4: Dewdrop Crystal-Jelly (晨雾冰晶果冻)
     ========================================================= */
  body[data-paradigm="dewdrop"] {
    --bg-canvas: #D5EBFF;
    --bg-surface: rgba(236, 248, 255, 0.60);
    --bg-surface-solid: #F0F8FF;
    --bg-elevated: rgba(196, 226, 255, 0.64);
    --bg-hover: rgba(178, 218, 255, 0.56);
    --ink-1: #0E2238;
    --ink-2: #213C58;
    --ink-3: #355370;
    --line-soft: rgba(126, 174, 222, 0.32);
    --line-strong: rgba(92, 150, 208, 0.50);

    --accent: #1864BC;
    --accent-ink: #FFFFFF;
    --accent-grad: linear-gradient(180deg, #3A88E2 0%, #1864BC 100%);
    --accent-soft: rgba(27, 104, 196, 0.14);
    --accent-glow: 0 7px 18px -4px rgba(24, 100, 188, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.34);
    --fresh-ink: #1457A8;

    --diff-bg: linear-gradient(135deg, rgba(244, 252, 255, 0.86) 0%, rgba(212, 236, 255, 0.70) 100%);
    --diff-border: rgba(88, 156, 226, 0.46);
    --diff-ink: #0F355C;
    --diff-badge-bg: #1864BC;
    --diff-badge-ink: #FFFFFF;

    --live-color: #DC543E;
    --live-soft: rgba(220, 84, 62, 0.18);
    --archive-ring: #1864BC;

    --jelly-island-bg: linear-gradient(155deg, rgba(240, 250, 255, 0.62) 0%, rgba(196, 228, 255, 0.44) 100%);
    --jelly-card-bg: linear-gradient(165deg, rgba(252, 254, 255, 0.82) 0%, rgba(214, 238, 255, 0.58) 100%);
    --jelly-pill-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.86) 0%, rgba(222, 241, 255, 0.66) 100%);
    --jelly-rim: rgba(255, 255, 255, 0.90);
    --jelly-shadow: 0 18px 42px -12px rgba(24, 74, 134, 0.13), 0 3px 10px -2px rgba(24, 74, 134, 0.05), inset 0 1.5px 0 rgba(255, 255, 255, 0.94), inset 0 -3px 10px rgba(98, 174, 252, 0.18);
    --card-shadow: 0 8px 22px -8px rgba(24, 74, 134, 0.11), inset 0 1px 0 rgba(255, 255, 255, 0.96);
    --pill-shadow: 0 3px 9px -2px rgba(24, 74, 134, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.94);

    --tag-bg: #1864BC;
    --tag-grad: linear-gradient(180deg, #3A88E2 0%, #1864BC 100%);
    --tag-ink: #FFFFFF;
    --tag-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.36), 0 3px 8px rgba(24, 100, 188, 0.24);

    --orb-1: rgba(54, 158, 255, 0.64);
    --orb-2: rgba(44, 218, 206, 0.48);
    --orb-3: rgba(132, 156, 255, 0.52);
    --orb-4: rgba(98, 198, 255, 0.50);
    --is-dark: 0;
  }

  /* =========================================================
     Theme 5: Amethyst Nebula Jelly (星云紫晶果冻)
     ========================================================= */
  body[data-paradigm="amethyst"] {
    --bg-canvas: #1D1736;
    --bg-surface: rgba(48, 38, 88, 0.66);
    --bg-surface-solid: #282048;
    --bg-elevated: rgba(72, 58, 126, 0.66);
    --bg-hover: rgba(90, 74, 152, 0.60);
    --ink-1: #F7F4FF;
    --ink-2: #E4DFFC;
    --ink-3: #C9BFEF;
    --line-soft: rgba(178, 158, 244, 0.22);
    --line-strong: rgba(202, 184, 255, 0.38);

    --accent: #7C3AED;
    --accent-ink: #FFFFFF;
    --accent-grad: linear-gradient(180deg, #9C66F5 0%, #7C3AED 100%);
    --accent-soft: rgba(168, 118, 255, 0.20);
    --accent-glow: 0 7px 20px -4px rgba(124, 58, 237, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.30);
    --fresh-ink: #DFB6FF;

    --diff-bg: linear-gradient(135deg, rgba(84, 62, 142, 0.72) 0%, rgba(52, 38, 98, 0.66) 100%);
    --diff-border: rgba(202, 168, 255, 0.42);
    --diff-ink: #F2E8FF;
    --diff-badge-bg: #6D28D9;
    --diff-badge-ink: #FFFFFF;

    --live-color: #FF948A;
    --live-soft: rgba(255, 148, 138, 0.22);
    --archive-ring: #B983FF;

    --jelly-island-bg: linear-gradient(155deg, rgba(58, 46, 104, 0.68) 0%, rgba(34, 27, 66, 0.56) 100%);
    --jelly-card-bg: linear-gradient(165deg, rgba(70, 56, 122, 0.76) 0%, rgba(44, 35, 84, 0.64) 100%);
    --jelly-pill-bg: linear-gradient(180deg, rgba(82, 66, 140, 0.80) 0%, rgba(52, 42, 96, 0.70) 100%);
    --jelly-rim: rgba(232, 220, 255, 0.22);
    --jelly-shadow: 0 20px 46px -10px rgba(7, 4, 20, 0.56), inset 0 1px 0 rgba(255, 255, 255, 0.20), inset 0 -3px 10px rgba(154, 104, 255, 0.18);
    --card-shadow: 0 10px 26px -8px rgba(7, 4, 20, 0.46), inset 0 1px 0 rgba(255, 255, 255, 0.20);
    --pill-shadow: 0 3px 9px -2px rgba(7, 4, 20, 0.36), inset 0 1px 0 rgba(255, 255, 255, 0.18);

    --tag-bg: #6D28D9;
    --tag-grad: linear-gradient(180deg, #965CF4 0%, #6D28D9 100%);
    --tag-ink: #FFFFFF;
    --tag-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), 0 3px 8px rgba(109, 40, 217, 0.34);

    --orb-1: rgba(156, 84, 255, 0.50);
    --orb-2: rgba(226, 104, 198, 0.36);
    --orb-3: rgba(108, 92, 248, 0.42);
    --orb-4: rgba(186, 124, 255, 0.38);
    --is-dark: 1;
  }

  body[data-scale="large"] {
    --fs-body: 16px;
    --fs-sub: 15px;
    --fs-tag: 13.5px;
    --fs-h3: 18.5px;
    --fs-h2: 24px;
  }

  /* 9 User Selectable Fonts (Preserved 100% per A06) */
  body[data-font="yahei"] { --display-font: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; --font-sans: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif; }
  body[data-font="wenkai_bold"] { --display-font: "HubWenKaiXBold", "HubWenKaiBold", serif; --font-sans: "HubWenKaiBold", serif; }
  body[data-font="wenkai_xbold"] { --display-font: "HubWenKaiXBold", serif; --font-sans: "HubWenKaiXBold", "HubWenKaiBold", serif; }
  body[data-font="wenkai_reg"] { --display-font: "HubWenKaiReg", "LXGW WenKai", serif; --font-sans: "HubWenKaiReg", "LXGW WenKai", serif; }
  body[data-font="kaiti"] { --display-font: "KaiTi", "楷体", "STKaiti", serif; --font-sans: "KaiTi", "楷体", "STKaiti", serif; }
  body[data-font="stkaiti"] { --display-font: "STKaiti", "华文楷体", "KaiTi", serif; --font-sans: "STKaiti", "华文楷体", "KaiTi", serif; }
  body[data-font="notoserif"] { --display-font: "Noto Serif SC", "STSong", "Georgia", serif; --font-sans: "Noto Serif SC", "STSong", "SimSun", serif; }
  body[data-font="dengxian"] { --display-font: "DengXian", "等线", "Noto Sans SC", sans-serif; --font-sans: "DengXian", "等线", "Noto Sans SC", sans-serif; }
  body[data-font="wenkai_reg"] *, body[data-font="kaiti"] *, body[data-font="stkaiti"] * { font-synthesis: weight; }

  * { margin: 0; padding: 0; box-sizing: border-box; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    background-color: var(--bg-canvas); color: var(--ink-1);
    font-family: var(--font-sans); font-size: var(--fs-body); line-height: 1.55;
    user-select: none;
  }
  .num { font-variant-numeric: tabular-nums; }
  button, input, textarea, select { font-family: inherit; color: inherit; }

  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  /* Diffused Ambient Jelly Orbs (softly glowing through translucent crystal islands) */
  .jelly-aurora { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .jelly-aurora .orb { position: absolute; border-radius: 50%; filter: blur(66px); will-change: transform; }
  .jelly-aurora .o1 { width: 560px; height: 520px; top: -110px; left: -60px; background: radial-gradient(circle, var(--orb-1) 0%, rgba(255,255,255,0) 68%); }
  .jelly-aurora .o2 { width: 580px; height: 540px; top: -80px; right: -40px; background: radial-gradient(circle, var(--orb-2) 0%, rgba(255,255,255,0) 68%); }
  .jelly-aurora .o3 { width: 620px; height: 500px; bottom: -120px; left: 16%; background: radial-gradient(circle, var(--orb-3) 0%, rgba(255,255,255,0) 68%); }
  .jelly-aurora .o4 { width: 520px; height: 460px; top: 26%; left: 38%; background: radial-gradient(circle, var(--orb-4) 0%, rgba(255,255,255,0) 68%); }

  .app-shell { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100vw; height: 100vh; }

  /* Floating Crystal Titlebar */
  .titlebar {
    height: 58px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 8px 16px 4px 20px; position: relative; z-index: 30;
  }
  .brand-cluster { display: flex; align-items: center; gap: 10px; pointer-events: none; flex-shrink: 0; }
  .brand-mark {
    width: 32px; height: 32px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    background-color: var(--accent); background-image: var(--accent-grad);
    color: var(--accent-ink); box-shadow: var(--accent-glow); flex-shrink: 0;
  }
  .brand-title { font-family: var(--display-font); font-size: 18.5px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink-1); white-space: nowrap; }
  .brand-sub { font-size: 12.5px; color: var(--ink-3); padding-left: 10px; border-left: 1px solid var(--line-soft); white-space: nowrap; }
  @media (max-width: 1380px) { .brand-sub { display: none; } }

  .nav-tabs {
    display: flex; align-items: center; gap: 4px; padding: 3.5px;
    border-radius: var(--radius-pill);
    background: var(--jelly-island-bg); backdrop-filter: blur(26px) saturate(185%);
    border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
  }
  .nav-tab {
    height: 31px; padding: 0 14px; border: none; border-radius: var(--radius-pill);
    background: transparent; color: var(--ink-2); font-size: 13.5px; font-weight: 500;
    cursor: pointer; transition: all 0.16s; white-space: nowrap;
  }
  .nav-tab:hover { color: var(--ink-1); background: var(--bg-hover); }
  .nav-tab.active {
    background-color: var(--accent); background-image: var(--accent-grad);
    color: var(--accent-ink); box-shadow: var(--accent-glow); font-weight: 600;
  }

  .toolbar-right { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }

  .top-search-box { position: relative; display: flex; align-items: center; width: 210px; }
  .top-search-box svg { position: absolute; left: 11px; color: var(--ink-3); pointer-events: none; }
  .top-search-input {
    width: 100%; height: 32px; padding: 0 32px 0 30px;
    border-radius: var(--radius-pill); border: 1px solid var(--jelly-rim);
    background: var(--jelly-pill-bg); box-shadow: var(--pill-shadow);
    color: var(--ink-1); font-size: 13px; outline: none; transition: border-color 0.15s, width 0.2s;
  }
  .top-search-input:focus { border-color: var(--accent); }
  .top-search-input::placeholder { color: var(--ink-3); }
  .top-search-kbd {
    position: absolute; right: 9px; font-size: 12px; color: var(--ink-3);
    padding: 0 5px; border-radius: 999px; background: var(--bg-elevated); pointer-events: none;
  }

  .icon-btn {
    height: 32px; padding: 0 11px; border-radius: var(--radius-pill);
    border: 1px solid var(--jelly-rim); background: var(--jelly-pill-bg);
    box-shadow: var(--pill-shadow); color: var(--ink-2); font-size: 13px; font-weight: 500;
    display: inline-flex; align-items: center; justify-content: center; gap: 5px; cursor: pointer;
    transition: transform 0.14s, color 0.14s, background 0.14s; white-space: nowrap;
  }
  .icon-btn.sq { width: 32px; padding: 0; }
  .icon-btn:hover { color: var(--ink-1); transform: translateY(-1px); }
  .icon-btn.accent-pill {
    background-color: var(--accent); background-image: var(--accent-grad);
    border-color: transparent; color: var(--accent-ink); box-shadow: var(--accent-glow); font-weight: 600;
  }

  .update-badge-btn {
    display: none; height: 32px; padding: 0 12px; border-radius: var(--radius-pill);
    border: none; background-color: var(--accent); background-image: var(--accent-grad);
    color: var(--accent-ink); box-shadow: var(--accent-glow); font-size: 13px; font-weight: 600;
    align-items: center; gap: 5px; cursor: pointer; white-space: nowrap;
  }
  .update-badge-btn.show { display: inline-flex; }

  .win-controls { display: flex; align-items: center; gap: 4px; margin-left: 4px; }
  .win-btn {
    width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--jelly-rim);
    background: var(--jelly-pill-bg); box-shadow: var(--pill-shadow); color: var(--ink-2);
    display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.14s;
  }
  .win-btn:hover { color: var(--ink-1); transform: translateY(-1px); }
  .win-btn.close:hover { background: #C83A2B; border-color: #C83A2B; color: #FFFFFF; }

  /* Main Stage */
  .stage-wrap { flex: 1; min-height: 0; position: relative; overflow: hidden; }
  .view-page { display: none; width: 100%; height: 100%; overflow: hidden; }
  .view-page.active { display: flex; flex-direction: column; }

  /* Crystal Jelly Island Base */
  .jelly-island {
    background: var(--jelly-island-bg);
    backdrop-filter: blur(28px) saturate(185%);
    border: 1px solid var(--jelly-rim);
    border-radius: var(--radius-island);
    box-shadow: var(--jelly-shadow);
    overflow: hidden;
  }

  /* Buttons */
  .deliv-btn {
    height: 33px; padding: 0 14px; border-radius: var(--radius-pill);
    border: 1px solid var(--jelly-rim); background: var(--jelly-pill-bg);
    box-shadow: var(--pill-shadow); color: var(--ink-1); font-size: 13px; font-weight: 600;
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    transition: transform 0.14s, box-shadow 0.14s; white-space: nowrap;
  }
  .deliv-btn:hover { transform: translateY(-1px); }
  .deliv-btn.primary {
    background-color: var(--accent); background-image: var(--accent-grad);
    border-color: transparent; color: var(--accent-ink); box-shadow: var(--accent-glow);
  }
  .deliv-btn.tint {
    background: var(--accent-soft); border-color: var(--line-strong); color: var(--fresh-ink);
  }
  .deliv-btn.ghost {
    background: transparent; border-color: var(--line-soft); box-shadow: none; color: var(--ink-2); font-weight: 500;
  }
  .deliv-btn.ghost:hover { background: var(--bg-hover); color: var(--ink-1); border-color: var(--line-strong); }
  .deliv-btn.sm { height: 28px; padding: 0 11px; font-size: 12.5px; }

  /* =========================================================
     VIEW 1A: CRYSTAL STAR-ATLAS HOME (星盘首屏)
     ========================================================= */
  .atlas-home-grid {
    flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.85fr) minmax(350px, 1fr);
    gap: 14px; padding: 6px 16px 16px; overflow: hidden;
  }
  .atlas-dial-island { display: flex; flex-direction: column; padding: 16px 22px 14px; position: relative; }
  .atlas-dial-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-shrink: 0; }
  .atlas-h1 { font-family: var(--display-font); font-size: 23px; font-weight: 700; color: var(--ink-1); line-height: 1.25; letter-spacing: -0.02em; }
  .atlas-sub { font-size: 13.5px; color: var(--ink-3); margin-top: 3px; }
  .atlas-legend { display: flex; align-items: center; gap: 14px; flex-shrink: 0; padding-top: 4px; }
  .legend-item { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--ink-2); }
  .dot-live { width: 9px; height: 9px; border-radius: 50%; background: var(--live-color); box-shadow: 0 0 0 3px var(--live-soft); display: inline-block; }
  .dot-norm { width: 9px; height: 9px; border-radius: 50%; background: var(--bg-surface-solid); border: 2px solid var(--archive-ring); display: inline-block; }

  .mandala-stage {
    flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center;
    padding: 0; margin-top: -20px; position: relative;
  }
  .mandala-stage svg { max-width: 100%; max-height: 100%; overflow: visible; }
  .mandala-node { cursor: pointer; transition: opacity 0.16s; }
  .mandala-node:hover .mn-halo { opacity: 0.9; }

  .atlas-guard-bar {
    flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 9px 14px; border-radius: var(--radius-pill);
    background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
  }
  .guard-left { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-2); min-width: 0; }

  /* Right Spotlight & Recent Topics Island */
  .atlas-side-island { display: flex; flex-direction: column; overflow: hidden; }
  .atlas-side-head { padding: 18px 20px 12px; border-bottom: 1px solid var(--line-soft); flex-shrink: 0; }
  .atlas-side-title { font-family: var(--display-font); font-size: 19px; font-weight: 700; color: var(--ink-1); }
  .atlas-kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 12px; }
  .kpi-cell {
    padding: 9px 10px; border-radius: var(--radius-md);
    background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
    text-align: center;
  }
  .kpi-val { font-family: var(--display-font); font-size: 20px; font-weight: 700; color: var(--ink-1); line-height: 1.15; }
  .kpi-lbl { font-size: 12px; color: var(--ink-3); margin-top: 2px; }

  .atlas-side-scroll { flex: 1; overflow-y: auto; padding: 12px 16px 18px; display: flex; flex-direction: column; gap: 10px; }
  .topic-focus-card {
    padding: 13px 15px; border-radius: var(--radius-lg);
    background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--card-shadow);
    cursor: pointer; transition: transform 0.16s, border-color 0.16s;
  }
  .topic-focus-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .tfc-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tfc-name { font-size: 15px; font-weight: 700; color: var(--ink-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tfc-time { font-size: 12px; color: var(--fresh-ink); font-weight: 600; flex-shrink: 0; }
  .tfc-hint { font-size: 14px; color: var(--ink-2); margin-top: 4px; line-height: 1.42; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tfc-foot { margin-top: 9px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tfc-stats { font-size: 12px; color: var(--ink-3); }

  /* =========================================================
     VIEW 1B: FOUR-TIER TOPIC -> FIG -> DATE BATCH -> TYPE WORKBENCH
     ========================================================= */
  .drill-shell { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 4px 16px 16px; gap: 12px; overflow: hidden; }

  /* Spring Crystal Breadcrumb Bar */
  .crumb-bar {
    flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 8px 14px; border-radius: var(--radius-pill);
    background: var(--jelly-island-bg); backdrop-filter: blur(28px) saturate(185%);
    border: 1px solid var(--jelly-rim); box-shadow: var(--jelly-shadow);
  }
  .crumb-left { display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: nowrap; overflow: hidden; }
  .crumb-sep { color: var(--ink-3); font-size: 14px; flex-shrink: 0; }
  .crumb-select {
    height: 30px; padding: 0 12px; border-radius: var(--radius-pill);
    border: 1px solid var(--jelly-rim); background: var(--jelly-pill-bg); box-shadow: var(--pill-shadow);
    color: var(--ink-1); font-size: 13.5px; font-weight: 600; outline: none; cursor: pointer; max-width: 240px;
  }
  .crumb-select option { background: var(--bg-surface-solid); color: var(--ink-1); }
  .crumb-fig-pill {
    height: 30px; padding: 0 12px; border-radius: var(--radius-pill);
    background: var(--accent-soft); border: 1px solid var(--line-strong);
    color: var(--ink-1); font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; white-space: nowrap;
  }
  .crumb-right { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }

  /* Three Floating Islands for Four-Tier Deep Dive */
  .drill-columns { flex: 1; min-height: 0; display: flex; gap: 14px; overflow: hidden; }

  /* Tier 2 Rail: Fig专席 */
  .fig-rail { width: 226px; flex-shrink: 0; display: flex; flex-direction: column; }
  .fig-rail-head { padding: 14px 16px 10px; border-bottom: 1px solid var(--line-soft); flex-shrink: 0; }
  .fig-rail-title { font-size: 14.5px; font-weight: 700; color: var(--ink-1); }
  .fig-rail-sub { font-size: 12px; color: var(--ink-3); margin-top: 2px; }
  .fig-rail-scroll {
    flex: 1; min-height: 0; overflow-y: auto; padding: 8px 10px 32px;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 22px), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 22px), transparent 100%);
  }
  .fig-sec-lbl { font-size: 12px; font-weight: 600; color: var(--ink-3); padding: 10px 10px 4px; }
  .fig-sec-lbl:first-child { padding-top: 2px; }
  .fig-nav-btn {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 8px 12px; margin-bottom: 3px; border-radius: var(--radius-pill);
    border: 1px solid transparent; background: transparent; color: var(--ink-2);
    font-size: 13.5px; text-align: left; cursor: pointer; transition: all 0.14s;
  }
  .fig-nav-btn:hover { background: var(--bg-hover); color: var(--ink-1); }
  .fig-nav-btn.active {
    background: var(--accent-soft); border-color: var(--line-strong);
    color: var(--ink-1); font-weight: 700; box-shadow: var(--pill-shadow);
  }
  .fig-nav-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .fig-nav-badge { font-size: 12px; color: var(--ink-3); flex-shrink: 0; }
  .fig-nav-btn.active .fig-nav-badge { color: var(--fresh-ink); font-weight: 700; }

  /* Tier 3 + Tier 4 Stage: Date Batches + Diff Summary + Typed Lanes */
  .batch-stage { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .batch-stage-head {
    padding: 13px 20px 11px; border-bottom: 1px solid var(--line-soft); flex-shrink: 0;
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .bs-title { font-family: var(--display-font); font-size: 20px; font-weight: 700; color: var(--ink-1); line-height: 1.25; }
  .bs-meta { font-size: 13px; color: var(--ink-3); margin-top: 2px; }
  .bs-type-filter { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .type-chip {
    height: 29px; padding: 0 11px; border-radius: var(--radius-pill);
    border: 1px solid var(--jelly-rim); background: var(--jelly-pill-bg); box-shadow: var(--pill-shadow);
    color: var(--ink-2); font-size: 12.5px; font-weight: 500; cursor: pointer; transition: all 0.14s;
  }
  .type-chip:hover { color: var(--ink-1); }
  .type-chip.active {
    background: var(--accent-soft); border-color: var(--accent);
    color: var(--ink-1); font-weight: 700;
  }

  .batch-scroll { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 14px 18px 28px; display: flex; flex-direction: column; gap: 13px; }

  /* Date / Session Batch Card (CRITICAL: flex: 0 0 auto prevents vertical collapse!) */
  .batch-card {
    flex: 0 0 auto;
    border-radius: var(--radius-lg);
    background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .batch-card-head {
    padding: 12px 15px 10px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    border-bottom: 1px solid var(--line-soft); cursor: pointer;
  }
  .batch-head-left { display: flex; align-items: center; gap: 9px; min-width: 0; flex-wrap: wrap; }
  .batch-date-pill {
    height: 27px; padding: 0 11px; border-radius: var(--radius-pill);
    background: var(--accent-soft); border: 1px solid var(--line-strong);
    color: var(--ink-1); font-size: 13px; font-weight: 700; display: inline-flex; align-items: center;
  }
  .batch-round-tag { font-size: 12.5px; font-weight: 700; color: var(--fresh-ink); }
  .batch-proj-name { font-size: 14px; font-weight: 500; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px; }
  .batch-plat-tag {
    padding: 2px 8px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 600;
    background: var(--bg-elevated); color: var(--ink-2); border: 1px solid var(--line-soft);
  }
  .batch-head-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

  /* Prominent Diff Summary Banner (Core A03 + A04 Feature) */
  .diff-banner {
    margin: 11px 14px 4px; padding: 10px 14px; border-radius: var(--radius-md);
    background: var(--diff-bg); border: 1px solid var(--diff-border);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .diff-banner-left { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }
  .diff-badge {
    flex-shrink: 0; padding: 3px 9px; border-radius: var(--radius-pill);
    background: var(--diff-badge-bg); color: var(--diff-badge-ink);
    font-size: 12px; font-weight: 700;
  }
  .diff-text { font-size: 14px; font-weight: 600; color: var(--diff-ink); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
  .diff-ai-btn {
    flex-shrink: 0; height: 26px; padding: 0 10px; border-radius: var(--radius-pill);
    border: 1px solid var(--diff-border); background: var(--jelly-pill-bg);
    color: var(--ink-1); font-size: 12px; font-weight: 600; cursor: pointer;
  }
  .diff-ai-btn:hover { border-color: var(--accent); }

  /* Tier 4: File Type Lanes inside Batch Card */
  .batch-body { padding: 10px 14px 14px; display: flex; flex-direction: column; gap: 12px; }
  .batch-card.collapsed .batch-body { display: none; }
  .lane-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7px; }
  .lane-title { font-size: 13px; font-weight: 700; color: var(--ink-2); display: inline-flex; align-items: center; gap: 7px; }
  .lane-cnt { font-size: 12px; color: var(--ink-3); font-weight: 500; }

  /* Visual Plate Grid (A4 PDFs & Single Subpanels) */
  .plate-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(196px, 1fr)); gap: 11px; }
  .plate-grid.subpanels { grid-template-columns: repeat(auto-fill, minmax(156px, 1fr)); gap: 9px; }
  .plate-card {
    padding: 7px; border-radius: var(--radius-md);
    background: var(--jelly-pill-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
    cursor: pointer; transition: transform 0.16s, border-color 0.16s; position: relative;
  }
  .plate-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .plate-card.selected { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft), var(--card-shadow); }
  .plate-artboard {
    position: relative; height: 158px; border-radius: 10px; background: #FFFFFF;
    padding: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .plate-grid.subpanels .plate-artboard { height: 118px; }
  .plate-artboard img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  .plate-tag {
    position: absolute; top: 6px; left: 6px; padding: 2px 8px; border-radius: var(--radius-pill);
    background-color: var(--tag-bg); background-image: var(--tag-grad); color: var(--tag-ink);
    font-size: 12px; font-weight: 600; box-shadow: var(--tag-shadow); z-index: 2;
  }
  .plate-cmp-btn {
    position: absolute; top: 6px; right: 6px; height: 24px; padding: 0 8px; border-radius: var(--radius-pill);
    border: 1px solid rgba(255,255,255,0.7); background: rgba(20, 26, 38, 0.78); color: #FFFFFF;
    font-size: 12px; font-weight: 600; cursor: pointer; opacity: 0; transition: opacity 0.14s; z-index: 3;
  }
  .plate-card:hover .plate-cmp-btn, .plate-card.selected .plate-cmp-btn { opacity: 1; }
  .plate-typo-fallback {
    display: none; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; gap: 4px; color: #364152; padding: 8px;
  }
  .plate-cap { padding: 7px 3px 1px; }
  .plate-name {
    font-size: 13.5px; font-weight: 600; color: var(--ink-1); line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;
  }
  .plate-sub { font-size: 12px; color: var(--ink-3); display: flex; justify-content: space-between; gap: 6px; margin-top: 2px; }

  /* Clean Document / HTML Rows */
  .doc-list {
    border-radius: var(--radius-md); border: 1px solid var(--line-soft);
    background: var(--bg-surface); overflow: hidden;
  }
  .doc-row {
    display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; align-items: center; gap: 12px;
    padding: 9px 13px; border-bottom: 1px solid var(--line-soft); cursor: pointer; transition: background 0.12s;
  }
  .doc-row:last-child { border-bottom: none; }
  .doc-row:hover { background: var(--bg-hover); }
  .doc-row.selected { background: var(--accent-soft); }
  .kind-pill {
    height: 25px; padding: 0 9px; border-radius: var(--radius-pill);
    background: var(--jelly-pill-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
    color: var(--ink-2); font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap;
  }
  .kind-pill.primary { background: var(--accent-soft); border-color: var(--line-strong); color: var(--ink-1); }
  .doc-title { font-size: 14px; font-weight: 600; color: var(--ink-1); line-height: 1.38; overflow-wrap: anywhere; }
  .doc-sub { font-size: 12px; color: var(--ink-3); margin-top: 2px; }
  .doc-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

  .fold-toggle-btn {
    width: 100%; padding: 8px 12px; border: 1px dashed var(--line-strong); border-radius: var(--radius-md);
    background: transparent; color: var(--ink-2); font-size: 13px; font-weight: 600; cursor: pointer;
    margin-top: 6px; transition: background 0.14s;
  }
  .fold-toggle-btn:hover { background: var(--bg-hover); color: var(--ink-1); }

  /* Right QuickLook Preview Island */
  .preview-island { width: 432px; flex-shrink: 0; display: flex; flex-direction: column; }
  .preview-island.collapsed { display: none; }
  .pv-head { padding: 14px 18px 12px; border-bottom: 1px solid var(--line-soft); flex-shrink: 0; }
  .pv-title { font-family: var(--display-font); font-size: 16.5px; font-weight: 700; color: var(--ink-1); line-height: 1.35; overflow-wrap: anywhere; }
  .pv-path { margin-top: 4px; font-size: 12px; color: var(--ink-3); word-break: break-all; user-select: text; }
  .pv-btn-row { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }
  .pv-body { flex: 1; overflow: auto; padding: 12px; display: flex; flex-direction: column; }
  .pv-img-box {
    flex: 1; display: flex; align-items: center; justify-content: center; padding: 10px;
    background: var(--jelly-card-bg); border-radius: 16px; border: 1px solid var(--jelly-rim); overflow: auto;
  }
  .pv-img-box img {
    max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in;
    background: #FFFFFF; padding: 8px; border-radius: 10px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
  }
  .pv-img-box.zoomed { align-items: flex-start; justify-content: flex-start; }
  .pv-img-box.zoomed img { max-width: none; max-height: none; cursor: zoom-out; }
  .pv-iframe { width: 100%; height: 100%; border: none; border-radius: 12px; background: #FFFFFF; flex: 1; }
  .pv-dossier { display: flex; flex-direction: column; gap: 11px; }
  .pv-dossier-card { padding: 13px 15px; border-radius: var(--radius-md); background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); }
  .pv-dossier-h { font-size: 13px; font-weight: 700; color: var(--ink-2); margin-bottom: 7px; }
  .pv-toc-item { font-size: 13.5px; color: var(--ink-1); padding: 5px 0; border-bottom: 1px solid var(--line-soft); line-height: 1.45; }
  .pv-toc-item:last-child { border-bottom: none; }
  .pv-mini-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .pv-mini-plate { padding: 5px; border-radius: 10px; background: var(--jelly-pill-bg); border: 1px solid var(--jelly-rim); cursor: pointer; }
  .pv-mini-art { height: 96px; background: #FFFFFF; border-radius: 8px; padding: 4px; display: flex; align-items: center; justify-content: center; }
  .pv-mini-art img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .pv-mini-cap { padding: 4px 3px 0; font-size: 12px; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pv-text-pre {
    padding: 15px 16px; border-radius: var(--radius-md); background: var(--jelly-card-bg);
    border: 1px solid var(--jelly-rim); font-size: 14px; line-height: 1.68; color: var(--ink-1);
    white-space: pre-wrap; overflow-wrap: anywhere; user-select: text;
  }
  .pv-md {
    padding: 16px 18px; border-radius: var(--radius-md); background: var(--jelly-card-bg);
    border: 1px solid var(--jelly-rim); font-size: 14px; line-height: 1.68; color: var(--ink-1); user-select: text;
  }
  .pv-md h1 { font-family: var(--display-font); font-size: 18px; font-weight: 700; margin: 4px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line-soft); }
  .pv-md h2 { font-family: var(--display-font); font-size: 16px; font-weight: 700; margin: 14px 0 6px; color: var(--ink-1); }
  .pv-md h3 { font-size: 14.5px; font-weight: 700; margin: 10px 0 4px; color: var(--ink-2); }
  .pv-md p { margin: 6px 0; color: var(--ink-2); }
  .pv-md ul { margin: 6px 0 8px 18px; color: var(--ink-2); }
  .pv-md li { margin: 3px 0; }
  .pv-md code { padding: 1px 6px; border-radius: 5px; background: var(--bg-elevated); font-family: var(--font-sans); font-size: 13px; color: var(--fresh-ink); }
  .pv-table { width: 100%; border-collapse: collapse; font-size: 13px; background: var(--jelly-card-bg); }
  .pv-table th, .pv-table td { padding: 6px 9px; border: 1px solid var(--line-soft); text-align: left; max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pv-table th { background: var(--bg-elevated); font-weight: 600; position: sticky; top: 0; }

  /* =========================================================
     VIEW 2: REAL FOLDER BROWSER
     ========================================================= */
  .folders-layout { flex: 1; min-height: 0; display: flex; gap: 14px; padding: 6px 16px 16px; overflow: hidden; }
  .folder-rail { width: 250px; flex-shrink: 0; display: flex; flex-direction: column; }
  .folder-center { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  /* =========================================================
     VIEW 3: FOCUSED LINEAGE MIND-MAP
     ========================================================= */
  .lineage-layout { flex: 1; min-height: 0; display: flex; gap: 14px; padding: 6px 16px 16px; overflow: hidden; }
  .lineage-rail { width: 242px; flex-shrink: 0; display: flex; flex-direction: column; }
  .mindmap-viewport { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .mm-top-bar { padding: 14px 20px 12px; border-bottom: 1px solid var(--line-soft); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mm-canvas-wrap { flex: 1; overflow: auto; padding: 20px 24px; position: relative; }
  .mm-canvas { position: relative; display: flex; align-items: flex-start; gap: 58px; min-width: max-content; }
  .mm-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .mm-col { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 18px; }
  .mm-root-node {
    width: 224px; padding: 16px 18px; border-radius: var(--radius-lg);
    background-color: var(--accent); background-image: var(--accent-grad); color: var(--accent-ink); box-shadow: var(--accent-glow);
  }
  .mm-branch-node {
    width: 248px; padding: 13px 15px; border-radius: var(--radius-md);
    background: var(--jelly-card-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--card-shadow);
  }
  .mm-leaf-group { display: flex; flex-direction: column; gap: 9px; }
  .mm-leaf-node {
    width: 390px; padding: 12px 14px; border-radius: var(--radius-md);
    background: var(--jelly-pill-bg); border: 1px solid var(--jelly-rim); box-shadow: var(--pill-shadow);
    cursor: pointer; transition: transform 0.14s, border-color 0.14s;
  }
  .mm-leaf-node:hover { transform: translateY(-1px); border-color: var(--accent); }

  /* =========================================================
     VIEW 4: MAINTENANCE, AUTO-UPDATE & LIGHTWEIGHT AI SETTINGS
     ========================================================= */
  .settings-scroll { flex: 1; overflow-y: auto; padding: 8px 16px 24px; }
  .settings-grid { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .set-card { padding: 20px 22px; display: flex; flex-direction: column; gap: 12px; }
  .set-h { font-family: var(--display-font); font-size: 18.5px; font-weight: 700; color: var(--ink-1); }
  .set-p { font-size: 14px; color: var(--ink-2); line-height: 1.62; }
  .field-row { display: flex; flex-direction: column; gap: 5px; }
  .field-lbl { font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .field-input {
    height: 36px; padding: 0 12px; border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong); background: var(--bg-surface-solid);
    color: var(--ink-1); font-size: 14px; outline: none;
  }
  .field-input:focus { border-color: var(--accent); }
  .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: var(--radius-md); background: var(--bg-elevated); }

  /* =========================================================
     A/B VISUAL DIFF LOUPE MODAL & SPACE LIGHTBOX & SEARCH OVERLAY
     ========================================================= */
  .modal-bg {
    position: fixed; inset: 0; z-index: 90; display: none; align-items: center; justify-content: center;
    background: rgba(12, 16, 24, 0.56); backdrop-filter: blur(14px); padding: 20px;
  }
  .modal-bg.open { display: flex; }

  .compare-dialog {
    width: min(1440px, 96vw); height: min(900px, 94vh);
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg-surface-solid); border: 1px solid var(--jelly-rim);
    border-radius: var(--radius-island); box-shadow: 0 28px 68px rgba(0, 0, 0, 0.42);
  }
  .cmp-head {
    padding: 10px 18px; border-bottom: 1px solid var(--line-soft);
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .cmp-title { font-family: var(--display-font); font-size: 17.5px; font-weight: 700; color: var(--ink-1); }
  .cmp-controls {
    padding: 8px 18px; border-bottom: 1px solid var(--line-soft); background: var(--bg-elevated);
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .cmp-pick-group { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 240px; }
  .cmp-pick-lbl { font-size: 13px; font-weight: 700; color: var(--ink-1); white-space: nowrap; }
  .cmp-select {
    flex: 1; min-width: 0; height: 30px; padding: 0 10px; border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong); background: var(--bg-surface-solid); color: var(--ink-1); font-size: 13px;
  }
  .cmp-meta-ribbon {
    padding: 6px 18px; border-bottom: 1px solid var(--line-soft); background: var(--bg-surface-solid);
    display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--ink-2);
  }
  .cmp-stage {
    flex: 1; min-height: 0; position: relative; overflow: auto; padding: 12px 16px;
    display: flex; align-items: center; justify-content: center; background: var(--bg-canvas);
  }
  .cmp-stage.zoomed-stage { align-items: flex-start; justify-content: flex-start; }

  /* Curtain Wipe Mode (Zero overlapping badges over artwork!) */
  .curtain-wrap {
    position: relative; display: inline-block;
    border-radius: 12px; overflow: hidden; background: #FFFFFF;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.20); cursor: ew-resize; user-select: none;
  }
  .curtain-img-base { display: block; max-height: 75vh; max-width: 90vw; object-fit: contain; pointer-events: none; }
  .curtain-overlay { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .curtain-overlay img { width: 100%; height: 100%; object-fit: contain; display: block; background: #FFFFFF; }
  .curtain-line {
    position: absolute; top: 0; bottom: 0; width: 2.5px; background: var(--accent);
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.35); pointer-events: none;
  }
  .curtain-knob {
    position: absolute; top: 50%; transform: translate(-50%, -50%);
    width: 36px; height: 36px; border-radius: 50%;
    background-color: var(--accent); background-image: var(--accent-grad); color: #FFFFFF;
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  /* Side-by-Side Mode */
  .sbs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; height: 100%; }
  .sbs-pane {
    display: flex; flex-direction: column; border-radius: 14px; overflow: hidden;
    background: var(--bg-surface-solid); border: 1px solid var(--line-soft);
  }
  .sbs-head { padding: 8px 14px; border-bottom: 1px solid var(--line-soft); font-size: 13px; font-weight: 700; color: var(--ink-1); display: flex; justify-content: space-between; }
  .sbs-body { flex: 1; overflow: auto; background: #FFFFFF; display: flex; align-items: center; justify-content: center; padding: 10px; }
  .sbs-body img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.16s; }

  /* Lightbox Modal */
  .lightbox-dialog {
    width: min(1240px, 92vw); height: min(860px, 90vh);
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg-surface-solid); border: 1px solid var(--jelly-rim); border-radius: var(--radius-island);
  }
  .lb-body { flex: 1; overflow: auto; display: flex; align-items: center; justify-content: center; background: var(--bg-canvas); padding: 18px; }
  .lb-body img { max-width: 100%; max-height: 100%; object-fit: contain; background: #FFFFFF; padding: 10px; border-radius: 12px; box-shadow: 0 12px 34px rgba(0, 0, 0, 0.16); }

  /* Search Overlay Dialog */
  .search-dialog {
    width: min(860px, 90vw); max-height: 78vh; display: flex; flex-direction: column; overflow: hidden;
    background: var(--bg-surface-solid); border: 1px solid var(--jelly-rim); border-radius: var(--radius-island);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.36);
  }
  .search-head { padding: 14px 18px; border-bottom: 1px solid var(--line-soft); display: flex; align-items: center; gap: 10px; }
  .search-big-input { flex: 1; border: none; background: transparent; font-size: 16px; color: var(--ink-1); outline: none; }
  .search-results { flex: 1; overflow-y: auto; padding: 10px 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .search-hit {
    padding: 10px 13px; border-radius: var(--radius-md); background: var(--jelly-card-bg);
    border: 1px solid var(--line-soft); cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 10px;
  }
  .search-hit:hover { border-color: var(--accent); }

  /* Popovers: Font Picker (9 Fonts) & Theme Picker (5 Crystal-Jelly Palettes) */
  .pop-panel {
    position: fixed; top: 56px; right: 16px; z-index: 80; display: none;
    padding: 16px; border-radius: var(--radius-island);
    background: var(--bg-surface-solid); border: 1px solid var(--jelly-rim);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.24);
  }
  .pop-panel.open { display: block; }
  .font-pop { width: 416px; right: 126px; }
  .font-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 12px; }
  .font-card {
    padding: 10px 12px; border-radius: var(--radius-md); border: 1px solid var(--line-soft);
    background: var(--bg-elevated); text-align: left; cursor: pointer; transition: all 0.14s;
  }
  .font-card.span-two { grid-column: span 2; display: flex; align-items: center; justify-content: space-between; }
  .font-card:hover { border-color: var(--accent); }
  .font-card.active { background: var(--accent-soft); border-color: var(--accent); }
  .fc-title { font-size: 14px; font-weight: 700; color: var(--ink-1); }
  .fc-sample { font-size: 12px; color: var(--ink-3); margin-top: 2px; }

  .tweaks-pop { width: 356px; }
  .tweak-option {
    width: 100%; margin-top: 8px; padding: 10px 12px; border-radius: var(--radius-md);
    border: 1px solid var(--line-soft); background: var(--bg-elevated);
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    text-align: left; cursor: pointer; transition: all 0.14s;
  }
  .tweak-option:hover { border-color: var(--accent); }
  .tweak-option.active { background: var(--accent-soft); border-color: var(--accent); }
  .tweak-opt-name { font-size: 14px; font-weight: 700; color: var(--ink-1); }
  .tweak-opt-desc { font-size: 12px; color: var(--ink-3); margin-top: 2px; }

  .toast {
    position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%) translateY(20px);
    padding: 9px 18px; border-radius: var(--radius-pill);
    background-color: var(--accent); background-image: var(--accent-grad); color: var(--accent-ink);
    box-shadow: var(--accent-glow); font-size: 13.5px; font-weight: 600;
    opacity: 0; pointer-events: none; transition: all 0.22s; z-index: 120;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>
</head>
<body data-paradigm="peach" data-scale="normal" data-font="default">

<div class="jelly-aurora" data-lint-skip="1"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="orb o4"></span></div>

<div class="app-shell">
  <!-- Floating Frameless Crystal Titlebar -->
  <header class="titlebar" id="titlebarDrag">
    <div class="brand-cluster">
      <div class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.5L19.5 9L12 21.5L4.5 9L12 2.5Z" fill="rgba(255,255,255,0.25)"/>
          <path d="M4.5 9H19.5"/>
          <path d="M12 2.5L9 9L12 21.5L15 9L12 2.5Z"/>
        </svg>
      </div>
      <span class="brand-title">模型输出管家</span>
      <span class="brand-sub meta-caption num" id="brandStatSub">水晶星盘四级成果工作台</span>
    </div>

    <nav class="nav-tabs" data-no-drag="1">
      <button class="nav-tab active" data-view="atlas" onclick="switchView('atlas')">课题星盘</button>
      <button class="nav-tab" data-view="folders" onclick="switchView('folders')">真实文件夹</button>
      <button class="nav-tab" data-view="lineage" onclick="switchView('lineage')">谱系脑图</button>
      <button class="nav-tab" data-view="settings" onclick="switchView('settings')">维护与设置</button>
    </nav>

    <div class="toolbar-right" data-no-drag="1">
      <div class="top-search-box">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7.5"/><line x1="16.65" y1="16.65" x2="21" y2="21"/></svg>
        <input type="text" class="top-search-input" id="topSearchTrigger" placeholder="秒搜 Fig / 报告 / 课题…" onfocus="openSearchModal()" oninput="openSearchModal(this.value)">
        <span class="top-search-kbd">/</span>
      </div>

      <button class="update-badge-btn" id="btnTopUpdate" onclick="triggerAutoUpdate()" title="发现 GitHub 新版本，点击下载并无缝重启更新">
        <span id="topUpdateLabel">发现新版</span>
      </button>

      <button class="icon-btn sq" onclick="nativeCall('pickRootDir')" title="切换纳管的大模型输出总目录">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      </button>

      <button class="icon-btn sq" onclick="triggerRefresh()" id="btnRefresh" title="立即重新扫描目录">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
      </button>

      <button class="icon-btn" onclick="toggleFontPop(event)" id="btnFontPicker" title="切换 9 款中文字体与字重">
        <span style="font-weight:700;font-size:13.5px;">Aa</span>
        <span id="currentFontLabel">原装混排</span>
      </button>

      <button class="icon-btn" onclick="toggleTweaks(event)" id="btnTweaks" title="切换 5 套柔和水晶果冻色板与字号">
        <span id="currentParadigmDot" style="width:10px;height:10px;border-radius:50%;background:var(--accent-grad);display:inline-block;"></span>
        <span id="currentParadigmLabel">蜜桃琥珀</span>
      </button>

      <div class="win-controls" data-lint-skip="1">
        <button class="win-btn" onclick="nativeCall('minWindow')" title="最小化"><svg width="11" height="11" viewBox="0 0 12 12"><line x1="2" y1="6" x2="10" y2="6" stroke="currentColor" stroke-width="1.5"/></svg></button>
        <button class="win-btn" onclick="nativeCall('maxWindow')" title="最大化 / 还原"><svg width="11" height="11" viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
        <button class="win-btn close" onclick="nativeCall('closeWindow')" title="最小化到系统托盘"><svg width="11" height="11" viewBox="0 0 12 12"><line x1="2.2" y1="2.2" x2="9.8" y2="9.8" stroke="currentColor" stroke-width="1.5"/><line x1="9.8" y1="2.2" x2="2.2" y2="9.8" stroke="currentColor" stroke-width="1.5"/></svg></button>
      </div>
    </div>
  </header>

  <main class="stage-wrap">
    <!-- VIEW 1: STAR-ATLAS <-> FOUR-TIER WORKBENCH -->
    <section class="view-page active" id="view-atlas">
      <!-- State A: Star-Atlas Home -->
      <div class="atlas-home-grid" id="atlasHomeStage">
        <div class="jelly-island atlas-dial-island">
          <div class="atlas-dial-head">
            <div>
              <h1 class="atlas-h1">科研课题水晶星盘</h1>
              <p class="atlas-sub meta-caption">单击任意课题星轨，按「课题 / Fig / 日期与改动 / 文件类型」四级脉络直达定稿</p>
            </div>
            <div class="atlas-legend">
              <span class="legend-item"><span class="dot-live"></span>活跃写入中</span>
              <span class="legend-item"><span class="dot-norm"></span>已归档课题</span>
            </div>
          </div>

          <div class="mandala-stage" id="mandalaContainer"></div>

          <div class="atlas-guard-bar">
            <div class="guard-left">
              <span class="dot-live"></span>
              <span id="guardSummaryText">本地纯离线引擎运行中</span>
            </div>
            <div style="display:flex;gap:8px;flex-shrink:0;">
              <button class="deliv-btn sm" onclick="switchView('folders')">真实文件夹直览</button>
              <button class="deliv-btn sm primary" onclick="enterLatestActiveTopic()">进入最近活跃课题</button>
            </div>
          </div>
        </div>

        <div class="jelly-island atlas-side-island">
          <div class="atlas-side-head">
            <div class="atlas-side-title">近期课题推进动态</div>
            <div class="atlas-kpi-row" id="atlasKpiRow"></div>
          </div>
          <div class="atlas-side-scroll" id="atlasRecentTopics"></div>
        </div>
      </div>

      <!-- State B: Four-Tier Deep-Dive Workbench -->
      <div class="drill-shell" id="atlasDrillStage" style="display:none;">
        <div class="crumb-bar">
          <div class="crumb-left">
            <button class="deliv-btn sm" onclick="backToStarAtlas()">返回课题星盘</button>
            <span class="crumb-sep">/</span>
            <select class="crumb-select" id="topicQuickSelect" onchange="enterTopic(this.value)"></select>
            <span class="crumb-sep">/</span>
            <span class="crumb-fig-pill" id="crumbFigLabel">Fig 1</span>
            <span class="meta-caption num" id="crumbSummaryMeta" style="font-size:13px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></span>
          </div>
          <div class="crumb-right">
            <button class="deliv-btn sm primary" id="btnOpenFigCompare" onclick="openCompareForCurrentFig()" style="display:none;">A/B 拉帘对比新旧版</button>
            <button class="deliv-btn sm" id="btnTogglePreview" onclick="togglePreviewPane()">阅览席</button>
          </div>
        </div>

        <div class="drill-columns">
          <!-- Tier 2: Fig Navigator Rail -->
          <aside class="jelly-island fig-rail">
            <div class="fig-rail-head">
              <div class="fig-rail-title" id="figRailTopicName">课题 Fig 专席</div>
              <div class="fig-rail-sub meta-caption" id="figRailTopicStats">按论文图序归整</div>
            </div>
            <div class="fig-rail-scroll" id="figRailScroll"></div>
          </aside>

          <!-- Tier 3 & 4: Date Batches with Diff Summary -> Typed File Lanes -->
          <div class="jelly-island batch-stage">
            <div class="batch-stage-head">
              <div style="min-width:0;">
                <h2 class="bs-title" id="batchStageTitle">Fig 1</h2>
                <div class="bs-meta meta-caption" id="batchStageSub">按日期与对话批次倒序排列</div>
              </div>
              <div class="bs-type-filter" id="batchTypeFilters"></div>
            </div>
            <div class="batch-scroll" id="batchScrollArea"></div>
          </div>

          <!-- Right QuickLook Preview Island -->
          <aside class="jelly-island preview-island" id="drillPreviewIsland">
            <div class="pv-head" id="pvHeaderBox">
              <div class="pv-title">即时阅览席</div>
              <div class="pv-path meta-caption">单击任意文件即刻在此预览高清组图、交互报告导览、文稿或数据表；按 Space 打开全屏灯箱</div>
            </div>
            <div class="pv-body" id="pvBodyBox">
              <div style="padding:48px 24px;text-align:center;color:var(--ink-3);font-size:14px;">单击左侧卡片预览高清内容，双击调用系统默认程序打开原件。</div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- VIEW 2: REAL DISK FOLDER BROWSER -->
    <section class="view-page" id="view-folders">
      <div class="folders-layout">
        <aside class="jelly-island folder-rail">
          <div class="fig-rail-head">
            <div class="fig-rail-title">磁盘输出目录</div>
            <div class="fig-rail-sub meta-caption">原样直览真实文件夹</div>
          </div>
          <div class="fig-rail-scroll" id="folderRailScroll"></div>
        </aside>
        <div class="jelly-island folder-center">
          <div class="batch-stage-head">
            <div style="min-width:0;">
              <h2 class="bs-title" id="folderCenterTitle">输出根目录</h2>
              <div class="bs-meta meta-caption" id="folderCenterPath" style="user-select:text;"></div>
            </div>
            <div style="display:flex;gap:8px;">
              <button class="deliv-btn sm" id="btnFolderUp" onclick="goParentFolder()" style="display:none;">上一级</button>
              <button class="deliv-btn sm primary" onclick="openCurrentFolderInExplorer()">在资源管理器打开</button>
            </div>
          </div>
          <div class="batch-scroll" id="folderCenterScroll"></div>
        </div>
        <aside class="jelly-island preview-island" id="folderPreviewIsland">
          <div class="pv-head" id="fpvHeaderBox"><div class="pv-title">文件预览</div></div>
          <div class="pv-body" id="fpvBodyBox"></div>
        </aside>
      </div>
    </section>

    <!-- VIEW 3: FOCUSED LINEAGE MIND-MAP -->
    <section class="view-page" id="view-lineage">
      <div class="lineage-layout">
        <aside class="jelly-island lineage-rail">
          <div class="fig-rail-head">
            <div class="fig-rail-title">课题演进谱系</div>
            <div class="fig-rail-sub meta-caption">选择课题展开版本分支树</div>
          </div>
          <div class="fig-rail-scroll" id="lineageRailScroll"></div>
        </aside>
        <div class="jelly-island mindmap-viewport">
          <div class="mm-top-bar">
            <div>
              <h2 class="bs-title" id="mmTopicTitle">课题谱系树</h2>
              <div class="bs-meta meta-caption" id="mmTopicDesc">100% 原大字号横向演进树，单击项目节点直入四级视图</div>
            </div>
            <div style="display:flex;gap:8px;">
              <button class="deliv-btn sm" onclick="toggleAllMmExpand()" id="btnMmExpandAll">展开全部历史版本</button>
              <button class="deliv-btn sm primary" onclick="enterTopic(STATE.lineageTopicId)">进入该课题四级视图</button>
            </div>
          </div>
          <div class="mm-canvas-wrap" id="mmCanvasWrap">
            <div class="mm-canvas" id="mmCanvas">
              <svg class="mm-svg" id="mmSvg"></svg>
              <div class="mm-col" id="mmColRoot"></div>
              <div class="mm-col" id="mmColBranches"></div>
              <div class="mm-col" id="mmColLeaves"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 4: MAINTENANCE, AUTO-UPDATE & OPTIONAL MICRO-SUMMARY API -->
    <section class="view-page" id="view-settings">
      <div class="settings-scroll">
        <div class="settings-grid">
          <!-- Card 1: Offline & GitHub Auto-Updater -->
          <div class="jelly-island set-card">
            <h2 class="set-h">离线单文件与 GitHub 自动更新</h2>
            <p class="set-p">本程序为纯离线免安装单文件，断网时所有星盘归类、本地改动差分、高清 PDF 预览与 A/B 叠图对比均可 100% 运行；联网时支持一键检查并无缝热替换升级。</p>
            <div class="toggle-row">
              <div>
                <div style="font-weight:700;font-size:14.5px;" id="setVerLine">当前版本：v4.0.0</div>
                <div class="meta-caption" style="font-size:12.5px;color:var(--ink-3);" id="setUpdateStatus">尚未检测远程更新</div>
              </div>
              <div style="display:flex;gap:8px;">
                <button class="deliv-btn sm" onclick="checkGithubUpdate(true)" id="btnManualCheckUpd">检查更新</button>
                <button class="deliv-btn sm primary" onclick="triggerAutoUpdate()" id="btnSettingsApplyUpd" style="display:none;">立即更新并重启</button>
              </div>
            </div>
            <div class="meta-caption" style="font-size:12.5px;color:var(--ink-3);" id="setExePathLine"></div>
          </div>

          <!-- Card 2: Optional Ultra-Low-Cost Micro-Summary LLM API (A04) -->
          <div class="jelly-island set-card">
            <h2 class="set-h">可选轻量 AI 改动微摘要（极低成本）</h2>
            <p class="set-p">默认由纯本地零费用引擎自动对比前后两轮文件差异。如需把每个日期批次的改动说明提炼得更凝练，可按需配置任意 OpenAI 兼容轻量模型接口（仅传入 ≤120 token 文件名差异，禁止深度推理，结果永久缓存本地，单次成本低于 0.0001 元）。</p>
            <div class="toggle-row">
              <span style="font-weight:600;font-size:14px;">启用轻量 AI 微摘要辅助（手动触发并永久缓存）</span>
              <input type="checkbox" id="llmEnabledChk" style="width:18px;height:18px;accent-color:var(--accent);cursor:pointer;">
            </div>
            <div class="field-row">
              <label class="field-lbl" for="llmBaseUrl">API Base URL（OpenAI 兼容地址）</label>
              <input type="text" class="field-input" id="llmBaseUrl" placeholder="https://api.openai.com/v1">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <div class="field-row">
                <label class="field-lbl" for="llmModel">轻量非推理模型名</label>
                <input type="text" class="field-input" id="llmModel" placeholder="gpt-4o-mini / deepseek-chat">
              </div>
              <div class="field-row">
                <label class="field-lbl" for="llmApiKey">API Key（仅存本机不上传）</label>
                <input type="password" class="field-input" id="llmApiKey" placeholder="sk-...">
              </div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:4px;">
              <span class="meta-caption" style="font-size:12.5px;color:var(--ink-3);" id="llmKeyHint">未配置密钥</span>
              <button class="deliv-btn primary" onclick="saveLlmSettings()">保存微摘要配置</button>
            </div>
          </div>

          <!-- Card 3: Disk Storage & Non-Destructive Tidy -->
          <div class="jelly-island set-card">
            <h2 class="set-h">磁盘存储分布与无损归整</h2>
            <p class="set-p" id="storageDetailText">正在读取本地存储统计...</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
              <button class="deliv-btn primary" onclick="triggerSafeTidy()" id="btnRunTidy">增量更新快捷方式与无损归整</button>
              <button class="deliv-btn" onclick="openFolderShortcut('00_按课题总览')">打开按课题总览目录</button>
              <button class="deliv-btn" onclick="openFolderShortcut('_归档与杂项')">查看隔离杂项</button>
            </div>
          </div>

          <!-- Card 4: Live Write-Lock Guard -->
          <div class="jelly-island set-card">
            <h2 class="set-h">活跃写入保护清单</h2>
            <p class="set-p">最近 2 小时有写入或正处于交接链活跃状态的课题目录会自动加锁保护，增量归整绝不移动其路径。</p>
            <div id="guideLiveList" style="display:flex;flex-direction:column;gap:8px;"></div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<!-- Font Picker Popover (All 9 Fonts Preserved) -->
<div class="pop-panel font-pop" id="fontPop">
  <div style="display:flex;align-items:baseline;justify-content:space-between;">
    <span style="font-size:14.5px;font-weight:700;color:var(--ink-1);">全局字体与字重切换（9 款）</span>
    <span class="meta-caption" style="font-size:12px;color:var(--ink-3);">实时切换并自动记忆</span>
  </div>
  <div class="font-grid">
    <button class="font-card span-two active" data-f="default" onclick="setFontFamily('default')">
      <div class="fc-title" style="font-family:'Noto Serif SC',serif;">原装杂志混排（思源宋标题 + 思源黑正文）</div>
