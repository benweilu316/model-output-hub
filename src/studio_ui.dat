      <div class="fc-sample" style="font-family:'KaiTi',serif;">端庄正楷传统书韵</div>
    </button>
    <button class="font-card" data-f="stkaiti" onclick="setFontFamily('stkaiti')">
      <div class="fc-title" style="font-family:'STKaiti',serif;font-synthesis:weight;">华文楷体</div>
      <div class="fc-sample" style="font-family:'STKaiti',serif;">舒展碑帖书法笔意</div>
    </button>
    <button class="font-card" data-f="wenkai_reg" onclick="setFontFamily('wenkai_reg')">
