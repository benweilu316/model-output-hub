      <div class="fc-sample" style="font-family:'HubWenKaiReg',serif;">清隽轻盈手写书卷</div>
    </button>
    <button class="font-card" data-f="notoserif" onclick="setFontFamily('notoserif')">
      <div class="fc-title" style="font-family:'Noto Serif SC',serif;">思源宋体</div>
      <div class="fc-sample" style="font-family:'Noto Serif SC',serif;">典雅学术期刊衬线</div>
    </button>
    <button class="font-card" data-f="dengxian" onclick="setFontFamily('dengxian')">
      <div class="fc-title" style="font-family:'DengXian',sans-serif;">现代等线</div>
      <div class="fc-sample" style="font-family:'DengXian',sans-serif;">修长简净几何黑体</div>
    </button>
  </div>
</div>

<!-- Theme & Scale Popover (5 Soft Crystal-Jelly Palettes) -->
<div class="pop-panel tweaks-pop" id="tweaksPop">
  <div style="font-size:14.5px;font-weight:700;color:var(--ink-1);">柔和水晶果冻色板（5 套）</div>
  <div class="meta-caption" style="font-size:12px;color:var(--ink-3);margin-top:2px;">主视觉蜜桃琥珀，含新增凝脂偏白与黑曜偏黑两套果冻</div>

  <button class="tweak-option active" data-p="peach" onclick="setParadigm('peach')">
    <div><div class="tweak-opt-name">蜜桃琥珀果冻（默认主视觉）</div><div class="tweak-opt-desc">暖透奶油蜜桃珊瑚水晶折射</div></div>
    <span style="width:20px;height:20px;border-radius:50%;background:linear-gradient(180deg,#FF8266,#C73A22);box-shadow:inset 0 2px 1.5px rgba(255,255,255,0.82);flex-shrink:0;"></span>
  </button>

  <button class="tweak-option" data-p="alabaster" onclick="setParadigm('alabaster')">
    <div><div class="tweak-opt-name">凝脂白玉果冻（偏白浅色系）</div><div class="tweak-opt-desc">极简凝脂白瓷冻玉配沉静墨青</div></div>
    <span style="width:20px;height:20px;border-radius:50%;background:linear-gradient(180deg,#FFFFFF,#DCE4F2);border:1px solid #B5C2D8;box-shadow:inset 0 2px 1.5px #FFFFFF;flex-shrink:0;"></span>
  </button>

  <button class="tweak-option" data-p="obsidian" onclick="setParadigm('obsidian')">
    <div><div class="tweak-opt-name">黑曜墨晶果冻（偏黑深色系）</div><div class="tweak-opt-desc">深邃黑曜玄墨烟晶配冰蓝水光</div></div>
    <span style="width:20px;height:20px;border-radius:50%;background:linear-gradient(180deg,#3A4252,#0E1117);border:1px solid rgba(255,255,255,0.28);flex-shrink:0;"></span>
  </button>

  <button class="tweak-option" data-p="dewdrop" onclick="setParadigm('dewdrop')">
    <div><div class="tweak-opt-name">晨雾冰晶果冻</div><div class="tweak-opt-desc">冰川晴空柔光水透质感</div></div>
    <span style="width:20px;height:20px;border-radius:50%;background:linear-gradient(180deg,#52A6FF,#1864BC);box-shadow:inset 0 2px 1.5px rgba(255,255,255,0.82);flex-shrink:0;"></span>
  </button>

  <button class="tweak-option" data-p="amethyst" onclick="setParadigm('amethyst')">
    <div><div class="tweak-opt-name">星云紫晶果冻</div><div class="tweak-opt-desc">暮光薰衣草紫晶柔晕</div></div>
    <span style="width:20px;height:20px;border-radius:50%;background:linear-gradient(180deg,#BA84FF,#7C3AED);box-shadow:inset 0 2px 1.5px rgba(255,255,255,0.75);flex-shrink:0;"></span>
  </button>

  <div style="margin-top:12px;padding-top:10px;border-top:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;">
    <span style="font-size:13.5px;font-weight:600;">字号舒适度</span>
    <div style="display:flex;gap:6px;">
      <button class="type-chip active" id="scaleNormalBtn" onclick="setFontScale('normal')">灵动标准</button>
      <button class="type-chip" id="scaleLargeBtn" onclick="setFontScale('large')">舒朗放大</button>
    </div>
  </div>
</div>

<!-- A/B Visual Diff Loupe Modal -->
<div class="modal-bg" id="compareModal" onclick="if(event.target===this)closeCompareModal()">
  <div class="compare-dialog">
    <div class="cmp-head">
      <div>
        <div class="cmp-title" id="cmpModalTitle">新旧组图 A/B 拉帘对比镜</div>
        <div class="meta-caption" style="font-size:12.5px;color:var(--ink-3);" id="cmpModalSub">拖动拉杆扫过同一张 Fig 的旧版与新版，逐像素核对字号、配色与排版差异</div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <button class="type-chip active" id="btnCmpModeCurtain" onclick="setCompareMode('curtain')">拉帘叠图</button>
        <button class="type-chip" id="btnCmpModeSbs" onclick="setCompareMode('sbs')">双图并排</button>
        <button class="deliv-btn sm" onclick="closeCompareModal()">关闭</button>
      </div>
    </div>
    <div class="cmp-controls">
      <div class="cmp-pick-group">
        <span class="cmp-pick-lbl">左 / 旧版 A</span>
        <select class="cmp-select" id="cmpSelectA" onchange="renderCompareStage()"></select>
      </div>
      <div class="cmp-pick-group">
        <span class="cmp-pick-lbl">右 / 新版 B</span>
        <select class="cmp-select" id="cmpSelectB" onchange="renderCompareStage()"></select>
      </div>
      <div style="display:flex;align-items:center;gap:6px;" id="cmpZoomBar">
        <button class="type-chip active" data-z="1" onclick="setCmpZoom(1)">适应画幅</button>
        <button class="type-chip" data-z="1.45" onclick="setCmpZoom(1.45)">145%</button>
        <button class="type-chip" data-z="2" onclick="setCmpZoom(2)">200%</button>
      </div>
    </div>
    <div class="cmp-meta-ribbon" id="cmpMetaRibbon"></div>
    <div class="cmp-stage" id="cmpStageBox"></div>
  </div>
</div>

<!-- Fullscreen Spacebar Crystal Lightbox -->
<div class="modal-bg" id="lightboxModal" onclick="if(event.target===this)closeLightbox()">
  <div class="lightbox-dialog">
    <div class="cmp-head">
      <div style="min-width:0;">
        <div class="cmp-title" id="lbTitle">高清灯箱</div>
        <div class="meta-caption" style="font-size:12.5px;color:var(--ink-3);" id="lbSub"></div>
      </div>
      <div style="display:flex;gap:8px;flex-shrink:0;">
        <button class="deliv-btn sm" onclick="stepLightbox(-1)">上一张</button>
        <button class="deliv-btn sm" onclick="stepLightbox(1)">下一张</button>
        <button class="deliv-btn sm primary" id="lbOpenBtn">打开原件</button>
        <button class="deliv-btn sm" onclick="closeLightbox()">关闭</button>
      </div>
    </div>
    <div class="lb-body" id="lbBody"></div>
  </div>
</div>

<!-- Global Omni Search Modal -->
<div class="modal-bg" id="searchModal" onclick="if(event.target===this)closeSearchModal()">
  <div class="search-dialog">
    <div class="search-head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7.5"/><line x1="16.65" y1="16.65" x2="21" y2="21"/></svg>
      <input type="text" class="search-big-input" id="omniSearchInput" placeholder="输入课题名、Fig 号、文件名或关键词（支持全盘磁盘实时穿透检索）..." oninput="onOmniSearchInput()">
      <button class="deliv-btn sm" onclick="closeSearchModal()">关闭</button>
    </div>
    <div class="search-results" id="omniSearchResults"></div>
  </div>
</div>

<div class="toast" id="toastMsg">已执行</div>

<script>
  let HUB = null;
  let USER_META = { ui_gen: 5, starred: [], starred_files: [], notes: {}, topic_overrides: {}, ui_paradigm: 'peach', ui_scale: 'normal', ui_font: 'default' };
  let APP_INFO = { version: '4.0.0', repo: 'benweilu316/model-output-hub', llm_enabled: false };
  let UPDATE_INFO = null;
  let BATCH_DIFF_CACHE = {};
  let ALL_FILES = [];
  let TOPIC_TREE_V4 = {};
  let CURRENT_BATCH_FILES = [];
  let FOLDER_VIEW_DATA = null;
  let LIVE_SEARCH_TIMER = null;
  let LIVE_SEARCH_ITEMS = [];

  const EXPANDED_BATCHES = new Set();
  const EXPANDED_SUBPANELS = new Set();

  let STATE = {
    view: 'atlas',
    topicId: 'ALL',
    figGroup: '',
    typeFilter: 'ALL',
    previewOpen: true,
    selectedPath: '',
    lineageTopicId: '',
    mmExpandAll: false,
    folderPath: '',
    cmpMode: 'curtain',
    cmpPos: 52,
    cmpZoom: 1,
    cmpPool: [],
    lbIndex: -1,
    lbPool: []
  };

  const PARADIGM_META = {
    peach:     { label: '蜜桃琥珀', dark: false, ring: 'rgba(198,118,90,0.40)',  spoke: 'rgba(208,142,116,0.32)', accent: '#C73A22', live: '#C73A22', archiveRing: '#965D48', center: '#FFF9F5', ink1: '#2F150E', ink2: '#683629' },
    alabaster: { label: '凝脂白玉', dark: false, ring: 'rgba(128,148,180,0.40)', spoke: 'rgba(156,172,198,0.32)', accent: '#223B61', live: '#C23C32', archiveRing: '#4B5F80', center: '#FFFFFF', ink1: '#141923', ink2: '#4B576E' },
    obsidian:  { label: '黑曜墨晶', dark: true,  ring: 'rgba(182,196,222,0.28)', spoke: 'rgba(154,170,198,0.22)', accent: '#5F9BFF', live: '#FF8A7A', archiveRing: '#8AA0C4', center: '#171B24', ink1: '#F5F7FB', ink2: '#B4BFCF' },
    dewdrop:   { label: '晨雾冰晶', dark: false, ring: 'rgba(112,166,224,0.42)', spoke: 'rgba(138,184,232,0.34)', accent: '#1864BC', live: '#DC543E', archiveRing: '#1864BC', center: '#FFFFFF', ink1: '#0E2238', ink2: '#355370' },
    amethyst:  { label: '星云紫晶', dark: true,  ring: 'rgba(196,176,255,0.30)', spoke: 'rgba(178,156,246,0.22)', accent: '#B983FF', live: '#FF948A', archiveRing: '#B983FF', center: '#2E2354', ink1: '#F7F4FF', ink2: '#C9BFEF' }
  };
  const LEGACY_PARADIGM_MAP = { takram: 'dewdrop', pentagram: 'peach', sugiura: 'amethyst' };

  const FONT_NAMES = {
    default: '原装混排', wenkai_bold: '文楷加粗', wenkai_xbold: '文楷特粗', wenkai_reg: '文楷常规',
    yahei: '微软雅黑', kaiti: '标准楷体', stkaiti: '华文楷体', notoserif: '思源宋体', dengxian: '现代等线'
  };

  const PLUMBING_NOISE_RX = /^(?:_index|_map|manifest|readme|license|changelog|direction-approved|polish-log|state|ledger|donotretry|annotations|claim|prompt)\b|\.exe$|modeloutputhub|模型输出管家|便携包/i;

  function cleanLabel(s) {
    return String(s || '').replace(/\s*·\s*/g, '/');
  }
  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s).replace(/\s+·\s+/g, '/');
    return d.innerHTML;
  }
  function escAttr(s) {
    return String(s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
  }
  function formatFileSize(mb, kb) {
    const m = Number(mb || 0);
    if (m >= 0.1) return m.toFixed(2) + ' MB';
    const k = kb != null ? Number(kb) : (m * 1024);
    if (k >= 1) return Math.round(k) + ' KB';
    return '< 1 KB';
  }
  function renderCleanMarkdown(raw) {
    const lines = String(raw || '').replace(/\r\n/g, '\n').split('\n');
    const inline = (s) => esc(s)
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    let out = '', inUl = false;
    const closeUl = () => { if (inUl) { out += '</ul>'; inUl = false; } };
    lines.forEach(ln => {
      const t = ln.trim();
      if (!t) { closeUl(); return; }
      if (/^#{1}\s+/.test(t)) { closeUl(); out += `<h1>${inline(t.replace(/^#\s+/, ''))}</h1>`; }
      else if (/^#{2}\s+/.test(t)) { closeUl(); out += `<h2>${inline(t.replace(/^##\s+/, ''))}</h2>`; }
      else if (/^#{3,}\s+/.test(t)) { closeUl(); out += `<h3>${inline(t.replace(/^#{3,}\s+/, ''))}</h3>`; }
      else if (/^[-*+]\s+/.test(t)) {
        if (!inUl) { out += '<ul>'; inUl = true; }
        out += `<li>${inline(t.replace(/^[-*+]\s+/, ''))}</li>`;
      } else if (/^---+$/.test(t)) {
        closeUl(); out += '<hr style="border:none;border-top:1px solid var(--line-soft);margin:10px 0;">';
      } else {
        closeUl(); out += `<p>${inline(t)}</p>`;
      }
    });
    closeUl();
    return `<div class="pv-md">${out}</div>`;
  }
  function syncModalLintMask() {
    const anyOpen = ['compareModal', 'lightboxModal', 'searchModal'].some(id => {
      const el = document.getElementById(id);
      return el && el.classList.contains('open');
    });
    const shell = document.querySelector('.app-shell');
    if (shell) {
      if (anyOpen) shell.setAttribute('data-lint-skip', '1');
      else shell.removeAttribute('data-lint-skip');
    }
  }
  function simpleHash(str) {
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) {
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return 'b' + (h >>> 0).toString(16);
  }
  function showToast(msg) {
    const el = document.getElementById('toastMsg');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => el.classList.remove('show'), 2500);
  }
  function nativeCall(action, payload = {}) {
    const msg = Object.assign({ action }, payload);
    if (window.chrome && window.chrome.webview) {
      window.chrome.webview.postMessage(JSON.stringify(msg));
    }
  }
  function openDeliverable(fp) { nativeCall('openFile', { path: fp }); }
  function revealInExplorer(fp) { nativeCall('revealPath', { path: fp }); }
  function copyText(txt, tip) { nativeCall('copyText', { text: txt }); showToast(tip || '已复制到剪贴板'); }
  function openFolderShortcut(sub) {
    if (!HUB || !HUB.root_path) return;
    nativeCall('openFolder', { path: HUB.root_path.replace(/[\\/]+$/, '') + '\\' + sub });
  }

  // Frameless window drag
  document.getElementById('titlebarDrag').addEventListener('mousedown', (e) => {
    if (e.button !== 0 || e.target.closest('[data-no-drag], button, input, select')) return;
    if (e.detail === 2) nativeCall('maxWindow');
    else nativeCall('dragWindow');
  });

  // Global keyboard shortcuts
  window.__focusMainSearch = function() { openSearchModal(); };
  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement && document.activeElement.tagName) || '';
    const inInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

    if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'k' || e.key.toLowerCase() === 'f')) {
      e.preventDefault(); openSearchModal();
    } else if (!inInput && e.key === '/') {
      e.preventDefault(); openSearchModal();
    } else if (!inInput && e.code === 'Space' && STATE.selectedPath && !document.getElementById('compareModal').classList.contains('open')) {
      const ext = (STATE.selectedPath.split('.').pop() || '').toLowerCase();
      if (['pdf', 'png', 'jpg', 'jpeg', 'webp', 'svg'].includes(ext)) {
        e.preventDefault();
        if (document.getElementById('lightboxModal').classList.contains('open')) closeLightbox();
        else openLightbox(STATE.selectedPath);
      }
    } else if (document.getElementById('lightboxModal').classList.contains('open')) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); stepLightbox(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); stepLightbox(1); }
      else if (e.key === 'Escape') closeLightbox();
    } else if (e.key === 'Escape') {
      closeCompareModal(); closeSearchModal(); closeLightbox();
      document.getElementById('tweaksPop').classList.remove('open');
      document.getElementById('fontPop').classList.remove('open');
    }
  });

  document.addEventListener('click', (e) => {
    const tp = document.getElementById('tweaksPop'), tb = document.getElementById('btnTweaks');
    if (tp.classList.contains('open') && !tp.contains(e.target) && !tb.contains(e.target)) tp.classList.remove('open');
    const fp = document.getElementById('fontPop'), fb = document.getElementById('btnFontPicker');
    if (fp.classList.contains('open') && !fp.contains(e.target) && !fb.contains(e.target)) fp.classList.remove('open');
  });

  function toggleTweaks(e) { e.stopPropagation(); document.getElementById('fontPop').classList.remove('open'); document.getElementById('tweaksPop').classList.toggle('open'); }
  function toggleFontPop(e) { e.stopPropagation(); document.getElementById('tweaksPop').classList.remove('open'); document.getElementById('fontPop').classList.toggle('open'); }

  function persistUiPrefs() {
    nativeCall('savePrefs', {
      ui_gen: 5,
      ui_paradigm: USER_META.ui_paradigm || 'peach',
      ui_scale: USER_META.ui_scale || 'normal',
      ui_font: USER_META.ui_font || 'default'
    });
  }

  function setFontFamily(f, skipSave) {
    if (!FONT_NAMES[f]) f = 'default';
    document.body.setAttribute('data-font', f);
    document.getElementById('currentFontLabel').textContent = FONT_NAMES[f];
    document.querySelectorAll('.font-card').forEach(b => b.classList.toggle('active', b.getAttribute('data-f') === f));
    USER_META.ui_font = f;
    if (!skipSave) { persistUiPrefs(); showToast('已切换字体：' + FONT_NAMES[f]); }
    if (HUB && STATE.view === 'atlas' && STATE.topicId === 'ALL') renderMandala();
    if (HUB && STATE.view === 'lineage') setTimeout(drawMindmapWires, 30);
  }

  function setParadigm(p, skipSave) {
    if (LEGACY_PARADIGM_MAP[p]) p = LEGACY_PARADIGM_MAP[p];
    if (!PARADIGM_META[p]) p = 'peach';
    document.body.setAttribute('data-paradigm', p);
    document.getElementById('currentParadigmLabel').textContent = PARADIGM_META[p].label;
    document.querySelectorAll('.tweak-option').forEach(b => b.classList.toggle('active', b.getAttribute('data-p') === p));
    USER_META.ui_paradigm = p;
    if (!skipSave) { persistUiPrefs(); showToast('已切换果冻色板：' + PARADIGM_META[p].label); }
    if (HUB && STATE.view === 'atlas' && STATE.topicId === 'ALL') renderMandala();
    if (HUB && STATE.view === 'lineage') setTimeout(drawMindmapWires, 30);
  }

  function setFontScale(sc, skipSave) {
    sc = sc === 'large' ? 'large' : 'normal';
    document.body.setAttribute('data-scale', sc);
    document.getElementById('scaleNormalBtn').classList.toggle('active', sc === 'normal');
    document.getElementById('scaleLargeBtn').classList.toggle('active', sc === 'large');
    USER_META.ui_scale = sc;
    if (!skipSave) persistUiPrefs();
    if (HUB && STATE.view === 'lineage') setTimeout(drawMindmapWires, 30);
  }

  function switchView(v) {
    STATE.view = v;
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.toggle('active', t.getAttribute('data-view') === v));
    document.querySelectorAll('.view-page').forEach(p => p.classList.toggle('active', p.id === 'view-' + v));
    if (v === 'atlas') {
      renderAtlasOrDrill();
    } else if (v === 'folders') {
      loadFolderBrowser(STATE.folderPath || (HUB ? HUB.root_path : ''));
    } else if (v === 'lineage') {
      if (!STATE.lineageTopicId && HUB && HUB.topics && HUB.topics.length) STATE.lineageTopicId = HUB.topics[0].id;
      renderLineage();
      setTimeout(drawMindmapWires, 40);
    } else if (v === 'settings') {
      renderSettingsView();
    }
  }

  function formatRelTime(mtimeSec, fullDate) {
    if (!mtimeSec) return fullDate || '';
    const diff = Math.max(0, Date.now() / 1000 - mtimeSec);
    if (diff < 120) return '刚刚';
    if (diff < 3600) return Math.floor(diff / 60) + '分钟前';
    const dObj = new Date(mtimeSec * 1000), now = new Date();
    const hm = (fullDate || '').slice(11, 16) || dObj.toTimeString().slice(0, 5);
    if (dObj.toDateString() === now.toDateString()) return '今天 ' + hm;
    const yest = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
    if (dObj.toDateString() === yest.toDateString()) return '昨天 ' + hm;
    return (fullDate || '').slice(0, 16);
  }

  // =========================================================
  // FOUR-TIER DATA ENGINE: Topic -> Fig -> DateBatch(Diff) -> Type
  // =========================================================
  function extractSubBucket(rel) {
    const r = String(rel || '').replace(/\\/g, '/');
    const parts = r.split('/');
    if (parts.length <= 1) return 'root';
    return parts[0].toLowerCase();
  }

  function extractVerToken(text) {
    const m = String(text || '').match(/(?:^|[_\-\s])(v\d+(?:\.\d+)?|rev\d+|第\d+代|r\d+)/i);
    return m ? m[1] : '';
  }

  function computeLocalDiffSummary(curr, prev) {
    const a4Cnt = curr.lanes.a4.length;
    const sgCnt = curr.lanes.single.length;
    const htmlCnt = curr.lanes.html.length;
    const otherCnt = curr.lanes.other.length;

    const hintClean = cleanLabel(curr.changeHint || '').replace(/审阅报?告?$/,'').replace(/[…\s]+$/,'').trim();
    const hintTail = (hintClean && hintClean !== curr.projName && hintClean.length >= 4)
      ? ('；焦点：' + hintClean)
      : '';

    if (!prev) {
      const parts = [];
      if (a4Cnt) parts.push(`${a4Cnt}张A4整页组图`);
      if (sgCnt) parts.push(`${sgCnt}张单图子图`);
      if (htmlCnt) parts.push(`${htmlCnt}份交互报告`);
      if (!parts.length && otherCnt) parts.push(`${otherCnt}份演示/文稿`);
      return `初版建档：产出${parts.join('、') || '核心成果'}${hintTail}`;
    }

    const diffs = [];
    // 1. Version jump check
    const vPrev = extractVerToken(prev.projName + ' ' + (prev.lanes.html[0]?.name || '') + ' ' + (prev.lanes.a4[0]?.rel || ''));
    const vCurr = extractVerToken(curr.projName + ' ' + (curr.lanes.html[0]?.name || '') + ' ' + (curr.lanes.a4[0]?.rel || ''));
    if (vCurr && vCurr.toLowerCase() !== vPrev.toLowerCase()) {
      diffs.push(vPrev ? `版本推进 ${vPrev} 至 ${vCurr}` : `升至 ${vCurr}`);
    }

    // 2. A4 PDF dim / size / update check
    const a4C = curr.lanes.a4[0];
    const a4P = prev.lanes.a4[0];
    if (a4C && a4P) {
      if (a4C.dimMm && a4P.dimMm && a4C.dimMm !== a4P.dimMm) {
        diffs.push(`A4幅面调整(${a4P.dimMm}改${a4C.dimMm})`);
      } else if (Math.abs((a4C.sizeMb || 0) - (a4P.sizeMb || 0)) >= 0.05) {
        const delta = ((a4C.sizeMb || 0) - (a4P.sizeMb || 0));
        diffs.push(`重绘A4组图(${delta > 0 ? '+' : ''}${delta.toFixed(2)}MB)`);
      } else {
        diffs.push(`更新A4整页PDF(${a4Cnt}张)`);
      }
    } else if (a4C && !a4P) {
      diffs.push(`新增A4整页PDF(${a4Cnt}张)`);
    }

    // 3. Subpanel diff check
    const prevPanels = new Set(prev.lanes.single.map(x => x.figPanel || x.name).filter(Boolean));
    const currPanels = curr.lanes.single.map(x => x.figPanel || '').filter(Boolean);
    const addedPanels = Array.from(new Set(currPanels.filter(p => !prevPanels.has(p)))).sort();
    if (addedPanels.length > 0) {
      diffs.push(`新增子图面板 ${addedPanels.slice(0, 5).join('/')}`);
    } else if (sgCnt > 0) {
      const diffCnt = sgCnt - prev.lanes.single.length;
      if (diffCnt > 0) diffs.push(`补增${diffCnt}张单图子图`);
      else diffs.push(`更新${sgCnt}张单图子图`);
    }

    // 4. HTML report diff
    if (htmlCnt > 0) {
      const hNew = curr.lanes.html[0];
      const hOld = prev.lanes.html[0];
      if (!hOld || hNew.name !== hOld.name) diffs.push(`更新交互报告`);
    }

    if (!diffs.length) {
      if (otherCnt > 0) diffs.push(`更新${otherCnt}份配套文稿与数据`);
      else diffs.push(`同步刷新本轮文件`);
    }

    const prevTimeTag = (prev.dayStr === curr.dayStr && prev.hmStr === curr.hmStr)
      ? (prev.dayRoundLabel || '上轮')
      : (prev.dayStr === curr.dayStr ? (prev.hmStr + '上轮') : (prev.dayStr.slice(5) + '上轮'));
    return `较${prevTimeTag}：${diffs.slice(0, 3).join('，')}${hintTail}`;
  }

  function rebuildFourTierIndex() {
    ALL_FILES = [];
    TOPIC_TREE_V4 = {};
    if (!HUB || !HUB.projects) return;

    const tMap = {};
    (HUB.topics || []).forEach(t => {
      tMap[t.id] = t;
      TOPIC_TREE_V4[t.id] = { topic: t, figMap: new Map(), figs: [], latestMtime: 0, latestHint: '', latestHtml: null };
    });

    HUB.projects.forEach(p => {
      const tEntry = TOPIC_TREE_V4[p.topic_id];
      if (!tEntry) return;
      if ((p.mtime || 0) > tEntry.latestMtime) {
        tEntry.latestMtime = p.mtime || 0;
        tEntry.latestHint = p.change_hint || p.name;
      }

      const pushArr = (arr, ftype) => {
        (arr || []).forEach(f => {
          if (PLUMBING_NOISE_RX.test(f.name || '')) return;
          const ext = (f.name.includes('.') ? '.' + f.name.split('.').pop() : '').toLowerCase();
          let fg = f.fig_group || ((ftype === 'a4' || ftype === 'single' || ftype === 'image') ? '专题与汇总图' : '综合报告与整本交付');
          let ford = f.fig_order != null ? f.fig_order : ((ftype === 'a4' || ftype === 'single' || ftype === 'image') ? 90 : 999);
          // Tuck slide export PNGs neatly into general deliverables instead of cluttering Fig rail
          if (fg === 'PPT 幻灯片页') { fg = '综合报告与整本交付'; ford = 999; }

          const rawTitle = (ftype === 'html' && f.title && f.title !== f.name) ? cleanLabel(f.title) : f.name;
          const dtFull = f.date || p.datetime || '';
          const dayStr = dtFull.slice(0, 10) || (p.date || '未知日期');
          const hmStr = dtFull.slice(11, 16) || '00:00';
          const lane = (ftype === 'html') ? 'html'
            : (ftype === 'a4') ? 'a4'
            : (ftype === 'single' || ftype === 'image') ? 'single'
            : 'other';

          const item = {
            ftype, lane, ext,
            name: f.name,
            displayTitle: rawTitle,
            path: f.path,
            rel: f.rel || f.name,
            projKey: p.key,
            projName: p.name,
            changeHint: p.change_hint || '',
            topicId: p.topic_id,
            topicShort: cleanLabel(tEntry.topic.short),
            platform: p.platform || '',
            sizeMb: f.size_mb || 0,
            mtime: f.mtime || p.mtime || 0,
            date: dtFull,
            dayStr, hmStr,
            dimMm: f.dim_mm || '',
            figGroup: fg,
            figPanel: f.fig_panel || '',
            figOrder: ford,
            subBucket: extractSubBucket(f.rel)
          };
          ALL_FILES.push(item);

          if (ftype === 'html' && (!tEntry.latestHtml || item.mtime > tEntry.latestHtml.mtime)) {
            tEntry.latestHtml = item;
          }

          if (!tEntry.figMap.has(fg)) {
            tEntry.figMap.set(fg, { figGroup: fg, figOrder: ford, items: [], batches: [], visualPool: [] });
          }
          tEntry.figMap.get(fg).items.push(item);
        });
      };

      pushArr(p.htmls, 'html');
      pushArr(p.a4_pdfs, 'a4');
      pushArr(p.single_pdfs, 'single');
      pushArr(p.images, 'image');
      pushArr(p.pptxs, 'pptx');
      pushArr(p.docs, 'doc');
      pushArr(p.tables, 'table');
      pushArr(p.archives, 'archive');
    });

    ALL_FILES.sort((a, b) => b.mtime - a.mtime);

    // Build ordered Figs & Date/Session Batches with Diff Summaries per Topic
    Object.values(TOPIC_TREE_V4).forEach(tEntry => {
      const figs = Array.from(tEntry.figMap.values()).sort((a, b) => (a.figOrder - b.figOrder) || a.figGroup.localeCompare(b.figGroup));
      figs.forEach(fgObj => {
        // Group items by (dayStr, projKey, subBucket) then split same-key time gaps > 90 min
        const rawGroups = new Map();
        fgObj.items.forEach(it => {
          const gk = `${it.dayStr}|${it.projKey}|${it.subBucket}`;
          if (!rawGroups.has(gk)) rawGroups.set(gk, []);
          rawGroups.get(gk).push(it);
        });

        const batches = [];
        for (const arr of rawGroups.values()) {
          arr.sort((a, b) => b.mtime - a.mtime);
          let cluster = [];
          arr.forEach(it => {
            if (cluster.length && Math.abs(cluster[cluster.length - 1].mtime - it.mtime) > 5400) {
              batches.push(cluster);
              cluster = [it];
            } else {
              cluster.push(it);
            }
          });
          if (cluster.length) batches.push(cluster);
        }

        // Transform clusters into structured Batch objects
        const built = batches.map(arr => {
          arr.sort((a, b) => b.mtime - a.mtime);
          const lead = arr[0];
          const lanes = { html: [], a4: [], single: [], other: [] };
          arr.forEach(it => lanes[it.lane].push(it));
          lanes.single.sort((a, b) => String(a.figPanel || 'ZZ').localeCompare(String(b.figPanel || 'ZZ')) || (b.mtime - a.mtime));
          lanes.a4.sort((a, b) => b.mtime - a.mtime);
          const sigStr = `${tEntry.topic.id}|${fgObj.figGroup}|${lead.dayStr}|${lead.projKey}|${arr.map(x => x.name + ':' + x.sizeMb).slice(0, 12).join(',')}`;
          return {
            batchKey: `${tEntry.topic.id}__${fgObj.figGroup}__${lead.dayStr}__${Math.round(lead.mtime)}`,
            hash: simpleHash(sigStr),
            dayStr: lead.dayStr,
            hmStr: lead.hmStr,
            mtime: lead.mtime,
            projName: lead.projName,
            projKey: lead.projKey,
            subBucket: lead.subBucket,
            platform: lead.platform,
            changeHint: lead.changeHint,
            items: arr,
            lanes,
            dayRoundLabel: '',
            localDiff: '',
            compactDesc: ''
          };
        });

        // Sort oldest -> newest to compute sequential diffs & same-day round numbers
        built.sort((a, b) => a.mtime - b.mtime);
        const dayCounts = {};
        built.forEach(b => { dayCounts[b.dayStr] = (dayCounts[b.dayStr] || 0) + 1; });
        const daySeen = {};
        built.forEach((b, i) => {
          daySeen[b.dayStr] = (daySeen[b.dayStr] || 0) + 1;
          if (dayCounts[b.dayStr] > 1) {
            b.dayRoundLabel = `当日第 ${daySeen[b.dayStr]} 轮`;
          }
          const prev = i > 0 ? built[i - 1] : null;
          b.localDiff = computeLocalDiffSummary(b, prev);
          b.compactDesc = `${b.dayStr} ${b.hmStr} [${b.projName}] A4:${b.lanes.a4.map(x=>x.name).slice(0,2).join(',')} Single:${b.lanes.single.length} HTML:${b.lanes.html.map(x=>x.displayTitle.slice(0,22)).slice(0,1).join(',')}`;
        });

        // Reverse to newest -> oldest for UI presentation
        built.reverse();
        fgObj.batches = built;
        fgObj.hasA4 = built.some(b => b.lanes.a4.length > 0);
        fgObj.latestMtime = built.length ? built[0].mtime : 0;

        // Build visual comparison pool (prefer 1 representative A4 per batch, then additional visuals)
        const vPool = [];
        const seenVp = new Set();
        built.forEach((b, idx) => {
          const rep = b.lanes.a4[0] || b.lanes.single[0];
          if (rep && !seenVp.has(rep.path)) {
            seenVp.add(rep.path);
            vPool.push({
              path: rep.path,
              name: rep.name,
              label: `${b.dayStr} ${b.hmStr} ${b.dayRoundLabel ? '(' + b.dayRoundLabel + ') ' : ''}${rep.name}`,
              date: `${b.dayStr} ${b.hmStr}`,
              dimMm: rep.dimMm,
              sizeMb: rep.sizeMb,
              projName: b.projName,
              diffNote: b.localDiff
            });
          }
        });
        fgObj.visualPool = vPool;
      });
      tEntry.figs = figs;
    });

    const s = HUB.summary || {};
    document.getElementById('brandStatSub').textContent =
      `${(HUB.topics || []).length} 大课题 / ${s.total_html || 0} 报告 / ${s.total_a4_pdf || 0} 张 A4 组图`;
  }

  // =========================================================
  // RENDER VIEW 1A: CRYSTAL STAR-ATLAS HOME
  // =========================================================
  function renderAtlasOrDrill() {
    const homeEl = document.getElementById('atlasHomeStage');
    const drillEl = document.getElementById('atlasDrillStage');
    if (STATE.topicId === 'ALL') {
      homeEl.style.display = 'grid';
      drillEl.style.display = 'none';
      renderStarAtlasHome();
    } else {
      homeEl.style.display = 'none';
      drillEl.style.display = 'flex';
      renderFourTierWorkbench();
    }
  }

  function renderStarAtlasHome() {
    if (!HUB) return;
    const s = HUB.summary || {};
    document.getElementById('atlasKpiRow').innerHTML = `
      <div class="kpi-cell"><div class="kpi-val num">${s.total_projects || 0}</div><div class="kpi-lbl">阶段目录</div></div>
      <div class="kpi-cell"><div class="kpi-val num">${s.total_html || 0}</div><div class="kpi-lbl">交互报告</div></div>
      <div class="kpi-cell"><div class="kpi-val num" style="color:var(--accent);">${s.total_a4_pdf || 0}</div><div class="kpi-lbl">A4 组图</div></div>
      <div class="kpi-cell"><div class="kpi-val num">${s.total_single_pdf || 0}</div><div class="kpi-lbl">单图子图</div></div>
    `;

    const workingAgents = (HUB.herdr_agents || []).filter(a => a.status === 'working' || a.status === 'blocked');
    const activeTopicsCnt = (HUB.topics || []).filter(t => t.locked_count > 0).length;
    document.getElementById('guardSummaryText').textContent = workingAgents.length > 0
      ? `纯离线引擎运行中 / ${workingAgents.length} 个后台会话受实时写保护`
      : `纯离线引擎运行中 / ${s.locked_projects || 0} 个活跃目录受写保护（覆盖 ${activeTopicsCnt} 个活跃课题）`;

    renderMandala();

    // Recent active topics cards (top 6 by latest mtime)
    const ranked = (HUB.topics || [])
      .filter(t => t.project_count > 0)
      .map(t => ({ topic: t, entry: TOPIC_TREE_V4[t.id] }))
      .sort((a, b) => ((b.entry?.latestMtime || 0) - (a.entry?.latestMtime || 0)));

    document.getElementById('atlasRecentTopics').innerHTML = ranked.slice(0, 8).map(({ topic, entry }) => {
      const figCnt = (entry ? entry.figs.filter(f => f.figOrder < 900).length : 0);
      const hint = cleanLabel(entry?.latestHint || topic.title || '');
      const topHtml = entry?.latestHtml;
      return `
        <div class="topic-focus-card" onclick="enterTopic('${escAttr(topic.id)}')">
          <div class="tfc-top">
            <div class="tfc-name">${esc(cleanLabel(topic.short))}</div>
            <span class="tfc-time num">${esc(formatRelTime(entry?.latestMtime || topic.latest_mtime, ''))}</span>
          </div>
          <div class="tfc-hint">${esc(hint)}</div>
          <div class="tfc-foot">
            <span class="tfc-stats meta-caption num">${figCnt} 组 Fig / ${topic.a4_pdf_count || 0} A4图 / ${topic.html_count || 0} 报告</span>
            ${topHtml ? `<button class="deliv-btn sm" onclick="event.stopPropagation();openDeliverable('${escAttr(topHtml.path)}')">最新报告</button>` : ''}
          </div>
        </div>
      `;
    }).join('');
  }

  function renderMandala(hoverTopicId) {
    const box = document.getElementById('mandalaContainer');
    if (!box || !HUB) return;
    const topics = HUB.topics || [];
    const W = 760, H = 468;
    const cx = W / 2, cy = H / 2;
    const rInner = 64, rArc = 104, rNode = 142, rLabel = 172;
    const pKey = document.body.getAttribute('data-paradigm') || 'peach';
    const pm = PARADIGM_META[pKey] || PARADIGM_META.peach;

    let ticks = '';
    for (let i = 0; i < 72; i++) {
      const a = (i * 5) * Math.PI / 180;
      const r1 = i % 6 === 0 ? rArc - 14 : rArc - 9;
      const r2 = rArc - 3;
      ticks += `<line x1="${(cx + r1 * Math.cos(a)).toFixed(1)}" y1="${(cy + r1 * Math.sin(a)).toFixed(1)}" x2="${(cx + r2 * Math.cos(a)).toFixed(1)}" y2="${(cy + r2 * Math.sin(a)).toFixed(1)}" stroke="${pm.ring}" stroke-width="${i % 6 === 0 ? 1.4 : 0.85}"/>`;
    }

    let arcs = '', nodes = '';
    topics.forEach((t, idx) => {
      const ang = -Math.PI / 2 + (idx * 2 * Math.PI / Math.max(1, topics.length));
      const nx = cx + rNode * Math.cos(ang), ny = cy + rNode * Math.sin(ang);
      const lx = cx + rLabel * Math.cos(ang), ly = cy + rLabel * Math.sin(ang);

      const halfSpan = Math.min(0.23, Math.max(0.06, (t.project_count / 70) * 0.23));
      const sa1 = ang - halfSpan, sa2 = ang + halfSpan;
      const ax1 = (cx + rArc * Math.cos(sa1)).toFixed(1), ay1 = (cy + rArc * Math.sin(sa1)).toFixed(1);
      const ax2 = (cx + rArc * Math.cos(sa2)).toFixed(1), ay2 = (cy + rArc * Math.sin(sa2)).toFixed(1);

      const isHov = hoverTopicId === t.id;
      const isLive = t.locked_count > 0;
      const col = isLive ? pm.live : pm.archiveRing;
      const op = hoverTopicId ? (isHov ? '1' : '0.32') : '0.84';

      arcs += `<path d="M ${ax1} ${ay1} A ${rArc} ${rArc} 0 0 1 ${ax2} ${ay2}" fill="none" stroke="${col}" stroke-width="${isHov ? 8 : 5}" stroke-linecap="round" opacity="${op}"/>`;
      arcs += `<line x1="${(cx + rInner * Math.cos(ang)).toFixed(1)}" y1="${(cy + rInner * Math.sin(ang)).toFixed(1)}" x2="${nx.toFixed(1)}" y2="${ny.toFixed(1)}" stroke="${isHov ? col : pm.spoke}" stroke-width="${isHov ? 2 : 1.1}"/>`;

      const cosV = Math.cos(ang), sinV = Math.sin(ang);
      const anchor = Math.abs(cosV) < 0.22 ? 'middle' : (cosV > 0 ? 'start' : 'end');
      const dx = anchor === 'start' ? 8 : (anchor === 'end' ? -8 : 0);
      const dy = sinV < -0.78 ? -12 : (sinV > 0.78 ? 12 : 0);
      const rDot = Math.min(13, Math.max(7, 6 + Math.sqrt(t.project_count) * 0.88));
      const figCnt = TOPIC_TREE_V4[t.id] ? TOPIC_TREE_V4[t.id].figs.filter(f => f.figOrder < 900).length : 0;

      nodes += `
        <g class="mandala-node" onclick="enterTopic('${escAttr(t.id)}')" onmouseenter="updateMandalaCenter('${escAttr(t.id)}')" onmouseleave="updateMandalaCenter('')">
          ${isLive ? `<circle cx="${nx.toFixed(1)}" cy="${ny.toFixed(1)}" r="${(rDot + 5.5).toFixed(1)}" fill="none" stroke="${pm.live}" stroke-width="1.5" opacity="0.65"/>` : ''}
          <circle cx="${nx.toFixed(1)}" cy="${ny.toFixed(1)}" r="${rDot.toFixed(1)}" fill="${isLive ? pm.live : pm.center}" stroke="${col}" stroke-width="2.2"/>
          <text x="${(lx + dx).toFixed(1)}" y="${(ly + dy - 2).toFixed(1)}" text-anchor="${anchor}" fill="${pm.ink1}" font-size="14.5" font-weight="${isHov ? '700' : '600'}">${esc(cleanLabel(t.short))}</text>
          <text x="${(lx + dx).toFixed(1)}" y="${(ly + dy + 16).toFixed(1)}" text-anchor="${anchor}" fill="${pm.ink2}" font-size="13">${figCnt} 组Fig / ${t.a4_pdf_count || 0} A4 / ${t.html_count || 0} 报告</text>
        </g>
      `;
    });

    box.innerHTML = `
      <svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">
        <defs>
          <radialGradient id="jellyCoreGrad" cx="35%" cy="30%" r="70%">
            <stop offset="0%" stop-color="${pm.center}" stop-opacity="0.98"/>
            <stop offset="100%" stop-color="${pm.accent}" stop-opacity="0.16"/>
          </radialGradient>
        </defs>
        <circle cx="${cx}" cy="${cy}" r="${rNode + 18}" fill="none" stroke="${pm.ring}" stroke-width="0.9" opacity="0.48"/>
        <circle cx="${cx}" cy="${cy}" r="${rNode}" fill="none" stroke="${pm.ring}" stroke-width="1.1" stroke-dasharray="3 4"/>
        <circle cx="${cx}" cy="${cy}" r="${rArc}" fill="none" stroke="${pm.ring}" stroke-width="1.1"/>
        ${ticks}
        ${arcs}
        ${nodes}
        <g style="cursor:pointer;" onclick="enterLatestActiveTopic()">
          <circle cx="${cx}" cy="${cy}" r="${rInner}" fill="url(#jellyCoreGrad)" stroke="${pm.accent}" stroke-width="2.2"/>
          <text id="mandalaCenterNum" x="${cx}" y="${cy - 4}" text-anchor="middle" fill="${pm.ink1}" style="font-family:var(--display-font);" font-size="31" font-weight="700">${HUB.summary.total_projects}</text>
          <text id="mandalaCenterCap" x="${cx}" y="${cy + 20}" text-anchor="middle" fill="${pm.ink2}" font-size="13" font-weight="600">全部课题总库</text>
        </g>
      </svg>
    `;
  }

  function updateMandalaCenter(tid) {
    const numEl = document.getElementById('mandalaCenterNum');
    const capEl = document.getElementById('mandalaCenterCap');
    if (!numEl || !capEl || !HUB) return;
    if (!tid) {
      numEl.textContent = HUB.summary.total_projects;
      capEl.textContent = '全部课题总库';
      return;
    }
    const t = (HUB.topics || []).find(x => x.id === tid);
    if (!t) return;
    numEl.textContent = t.a4_pdf_count || t.project_count;
    capEl.textContent = (t.a4_pdf_count ? '张A4组图' : '个阶段目录');
  }

  function enterLatestActiveTopic() {
    if (!HUB || !HUB.topics || !HUB.topics.length) return;
    const best = (HUB.topics || []).slice().sort((a, b) => ((TOPIC_TREE_V4[b.id]?.latestMtime || 0) - (TOPIC_TREE_V4[a.id]?.latestMtime || 0)))[0];
    if (best) enterTopic(best.id);
  }

  function backToStarAtlas() {
    STATE.topicId = 'ALL';
    STATE.figGroup = '';
    STATE.typeFilter = 'ALL';
    renderAtlasOrDrill();
  }

  function enterTopic(topicId, preferredFig) {
    if (!TOPIC_TREE_V4[topicId]) return;
    STATE.view = 'atlas';
    STATE.topicId = topicId;
    STATE.typeFilter = 'ALL';
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.toggle('active', t.getAttribute('data-view') === 'atlas'));
    document.querySelectorAll('.view-page').forEach(p => p.classList.toggle('active', p.id === 'view-atlas'));

    const tEntry = TOPIC_TREE_V4[topicId];
    if (preferredFig && tEntry.figMap.has(preferredFig)) {
      STATE.figGroup = preferredFig;
    } else {
      // Pick first main Fig that has multi-round A4 PDFs, else first Fig
      const bestFig = tEntry.figs.find(f => f.figOrder >= 1 && f.figOrder < 90 && f.hasA4 && f.batches.length >= 2)
        || tEntry.figs.find(f => f.hasA4)
        || tEntry.figs[0];
      STATE.figGroup = bestFig ? bestFig.figGroup : '';
    }
    renderAtlasOrDrill();
  }

  // =========================================================
  // RENDER VIEW 1B: FOUR-TIER WORKBENCH
  // =========================================================
  function selectFigGroup(fg) {
    STATE.figGroup = fg;
    STATE.typeFilter = 'ALL';
    renderFourTierWorkbench();
  }

  function setBatchTypeFilter(tp) {
    STATE.typeFilter = tp;
    renderBatchStageOnly();
  }

  function togglePreviewPane() {
    STATE.previewOpen = !STATE.previewOpen;
    document.getElementById('drillPreviewIsland').classList.toggle('collapsed', !STATE.previewOpen);
    document.getElementById('btnTogglePreview').classList.toggle('tint', STATE.previewOpen);
  }

  function renderFourTierWorkbench() {
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    if (!tEntry) { backToStarAtlas(); return; }

    // Breadcrumb Topic Dropdown
    const selEl = document.getElementById('topicQuickSelect');
    selEl.innerHTML = (HUB.topics || []).filter(t => t.project_count > 0).map(t =>
      `<option value="${escAttr(t.id)}" ${t.id === STATE.topicId ? 'selected' : ''}>${esc(cleanLabel(t.short))} (${t.project_count}目录)</option>`
    ).join('');

    const figOnlyCnt = tEntry.figs.filter(f => f.figOrder < 900).length;
    document.getElementById('figRailTopicName').textContent = cleanLabel(tEntry.topic.short);
    document.getElementById('figRailTopicStats').textContent = `${figOnlyCnt} 组Fig / ${tEntry.topic.a4_pdf_count || 0} A4 / ${tEntry.topic.html_count || 0} 报告`;

    // Tier 2: Fig Rail partitioned cleanly
    const mainFigs = tEntry.figs.filter(f => f.figOrder < 90);
    const suppFigs = tEntry.figs.filter(f => f.figOrder >= 100 && f.figOrder < 300);
    const generalFigs = tEntry.figs.filter(f => f.figOrder === 90 || f.figOrder >= 300);

    const renderFigList = (arr) => arr.map(f => `
      <button class="fig-nav-btn ${f.figGroup === STATE.figGroup ? 'active' : ''}" onclick="selectFigGroup('${escAttr(f.figGroup)}')">
        <span class="fig-nav-name">${esc(f.figGroup)}</span>
        <span class="fig-nav-badge num">${f.batches.length}轮</span>
      </button>
    `).join('');

    let railHtml = '';
    if (mainFigs.length) railHtml += `<div class="fig-sec-lbl">主图专席 (Main Figs)</div>${renderFigList(mainFigs)}`;
    if (suppFigs.length) railHtml += `<div class="fig-sec-lbl">附图与附表 (Supp)</div>${renderFigList(suppFigs)}`;
    if (generalFigs.length) railHtml += `<div class="fig-sec-lbl">综合报告与全局件</div>${renderFigList(generalFigs)}`;
    document.getElementById('figRailScroll').innerHTML = railHtml || `<div style="padding:18px;color:var(--ink-3);font-size:13.5px;">该课题暂无交付文件</div>`;

    document.getElementById('drillPreviewIsland').classList.toggle('collapsed', !STATE.previewOpen);
    document.getElementById('btnTogglePreview').classList.toggle('tint', STATE.previewOpen);

    renderBatchStageOnly();
  }

  function renderBatchStageOnly() {
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    if (!tEntry) return;
    const fgObj = tEntry.figMap.get(STATE.figGroup) || tEntry.figs[0];
    if (!fgObj) {
      document.getElementById('batchScrollArea').innerHTML = `<div style="padding:48px;text-align:center;color:var(--ink-3);">暂无可展示的文件</div>`;
      return;
    }
    STATE.figGroup = fgObj.figGroup;
    document.getElementById('crumbFigLabel').textContent = fgObj.figGroup;
    document.getElementById('crumbSummaryMeta').textContent = `${fgObj.batches.length} 轮日期批次 / 共 ${fgObj.items.length} 份产物`;
    document.getElementById('batchStageTitle').textContent = `${cleanLabel(tEntry.topic.short)} / ${fgObj.figGroup}`;
    document.getElementById('batchStageSub').textContent = `共 ${fgObj.batches.length} 轮日期与对话修订记录，顶部高亮条自动标明每轮核心改动`;

    const cmpBtn = document.getElementById('btnOpenFigCompare');
    cmpBtn.style.display = fgObj.visualPool.length >= 2 ? 'inline-flex' : 'none';

    // Tier 4 Type Filter Chips
    const counts = { ALL: fgObj.items.length, html: 0, a4: 0, single: 0, other: 0 };
    fgObj.items.forEach(it => { counts[it.lane] = (counts[it.lane] || 0) + 1; });
    const chips = [
      { id: 'ALL', label: '全部类型' },
      { id: 'html', label: 'HTML 报告' },
      { id: 'a4', label: 'A4 整页 PDF' },
      { id: 'single', label: '单图 / 子图' },
      { id: 'other', label: 'PPT / 文稿表格' }
    ].filter(c => c.id === 'ALL' || counts[c.id] > 0);

    document.getElementById('batchTypeFilters').innerHTML = chips.map(c => `
      <button class="type-chip ${STATE.typeFilter === c.id ? 'active' : ''}" onclick="setBatchTypeFilter('${c.id}')">${esc(c.label)} (${counts[c.id]})</button>
    `).join('');

    // Render Date Batches (Tier 3) + Typed Lanes (Tier 4)
    CURRENT_BATCH_FILES = [];
    const scrollBox = document.getElementById('batchScrollArea');
    const htmlParts = [];

    fgObj.batches.forEach((b, bIdx) => {
      const showHtml = (STATE.typeFilter === 'ALL' || STATE.typeFilter === 'html') ? b.lanes.html : [];
      const showA4 = (STATE.typeFilter === 'ALL' || STATE.typeFilter === 'a4') ? b.lanes.a4 : [];
      const showSingle = (STATE.typeFilter === 'ALL' || STATE.typeFilter === 'single') ? b.lanes.single : [];
      const showOther = (STATE.typeFilter === 'ALL' || STATE.typeFilter === 'other') ? b.lanes.other : [];
      const visibleTotal = showHtml.length + showA4.length + showSingle.length + showOther.length;
      if (visibleTotal === 0) return;

      showHtml.concat(showA4, showSingle, showOther).forEach(x => CURRENT_BATCH_FILES.push(x));

      const isExpanded = (bIdx < 2) || EXPANDED_BATCHES.has(b.batchKey);
      const diffText = BATCH_DIFF_CACHE[b.hash] || b.localDiff;
      const isAiPolished = Boolean(BATCH_DIFF_CACHE[b.hash]);

      const corePaths = b.lanes.html.slice(0, 2).concat(b.lanes.a4.slice(0, 8), b.lanes.other.filter(x => x.ftype === 'pptx' || x.ftype === 'doc').slice(0, 3)).map(x => x.path);
      const exportPaths = corePaths.length ? corePaths : b.items.slice(0, 12).map(x => x.path);

      // Build Tier 4 Lanes HTML
      let lanesHtml = '';

      if (showHtml.length) {
        lanesHtml += `
          <div>
            <div class="lane-head"><span class="lane-title">交互式审阅报告 (HTML)</span><span class="lane-cnt meta-caption num">${showHtml.length} 份</span></div>
            <div class="doc-list">
              ${showHtml.map(f => renderDocRow(f, 'HTML', true)).join('')}
            </div>
          </div>
        `;
      }

      if (showA4.length) {
        lanesHtml += `
          <div>
            <div class="lane-head"><span class="lane-title">A4 整页拼图 (矢量 PDF)</span><span class="lane-cnt meta-caption num">${showA4.length} 张</span></div>
            <div class="plate-grid">
              ${showA4.map(f => renderPlateCard(f, false, fgObj.visualPool.length >= 2)).join('')}
            </div>
          </div>
        `;
      }

      if (showSingle.length) {
        const spOpen = EXPANDED_SUBPANELS.has(b.batchKey) || showSingle.length <= 6;
        const visSp = spOpen ? showSingle : showSingle.slice(0, 6);
        lanesHtml += `
          <div>
            <div class="lane-head"><span class="lane-title">单图与各个子图 (Panel PDF / PNG)</span><span class="lane-cnt meta-caption num">${showSingle.length} 张</span></div>
            <div class="plate-grid subpanels">
              ${visSp.map(f => renderPlateCard(f, true, fgObj.visualPool.length >= 2)).join('')}
            </div>
            ${(!spOpen) ? `<button class="fold-toggle-btn" onclick="expandSubpanels('${escAttr(b.batchKey)}')">展开本轮全部 ${showSingle.length} 张单图与子图</button>` : ''}
          </div>
        `;
      }

      if (showOther.length) {
        lanesHtml += `
          <div>
            <div class="lane-head"><span class="lane-title">演示文稿、图注与数据表</span><span class="lane-cnt meta-caption num">${showOther.length} 份</span></div>
            <div class="doc-list">
              ${showOther.slice(0, 12).map(f => renderDocRow(f, f.ftype === 'pptx' ? 'PPTX' : (f.ftype === 'table' ? '表格' : (f.ftype === 'archive' ? 'ZIP' : '文稿')), false)).join('')}
            </div>
          </div>
        `;
      }

      const prevB = (bIdx + 1 < fgObj.batches.length) ? fgObj.batches[bIdx + 1] : null;
      const aiBtnHtml = APP_INFO.llm_enabled && !isAiPolished
        ? `<button class="diff-ai-btn" id="aiBtn_${escAttr(b.hash)}" onclick="event.stopPropagation();triggerBatchAiSummary('${escAttr(b.batchKey)}','${escAttr(b.hash)}','${escAttr(prevB ? prevB.compactDesc : '')}','${escAttr(b.compactDesc)}')">AI 精炼</button>`
        : (isAiPolished ? `<span class="meta-caption" style="font-size:12px;color:var(--fresh-ink);font-weight:700;flex-shrink:0;">AI已精炼</span>` : '');

      htmlParts.push(`
        <article class="batch-card ${isExpanded ? '' : 'collapsed'}" id="bc_${escAttr(b.hash)}">
          <div class="batch-card-head" onclick="toggleBatchExpand('${escAttr(b.batchKey)}')">
            <div class="batch-head-left">
              <span class="batch-date-pill num">${esc(b.dayStr)} ${esc(b.hmStr)}</span>
              ${b.dayRoundLabel ? `<span class="batch-round-tag">${esc(b.dayRoundLabel)}</span>` : ''}
              <span class="batch-proj-name" title="${escAttr(b.projName)}">${esc(b.projName)}</span>
              ${b.platform ? `<span class="batch-plat-tag">${esc(b.platform)}</span>` : ''}
            </div>
            <div class="batch-head-actions" onclick="event.stopPropagation()">
              <button class="deliv-btn sm" onclick="copyBatchPaths('${escAttr(b.batchKey)}')" title="复制本轮核心交付文件的完整绝对路径">复制路径</button>
              <button class="deliv-btn sm" onclick="exportBatchZip('${escAttr(b.batchKey)}')" title="一键将本轮核心定稿打包为 ZIP">打包ZIP</button>
              <button class="deliv-btn sm" onclick="toggleBatchExpand('${escAttr(b.batchKey)}')">${isExpanded ? '收起' : `展开 (${visibleTotal})`}</button>
            </div>
          </div>

          <div class="diff-banner">
            <div class="diff-banner-left">
              <span class="diff-badge">${bIdx === fgObj.batches.length - 1 ? '初版记录' : '本轮变动'}</span>
              <span class="diff-text" id="diffTxt_${escAttr(b.hash)}">${esc(diffText)}</span>
            </div>
            ${aiBtnHtml}
          </div>

          <div class="batch-body">${lanesHtml}</div>
        </article>
      `);
    });

    scrollBox.innerHTML = htmlParts.join('') || `<div style="padding:48px;text-align:center;color:var(--ink-3);">当前类型筛选下暂无文件</div>`;

    // Auto-select first visual/HTML file for preview
    if (CURRENT_BATCH_FILES.length) {
      const stillIn = CURRENT_BATCH_FILES.some(x => x.path === STATE.selectedPath);
      if (!stillIn) {
        const pref = CURRENT_BATCH_FILES.find(x => x.lane === 'a4') || CURRENT_BATCH_FILES.find(x => x.lane === 'html') || CURRENT_BATCH_FILES[0];
        selectFileForPreview(pref.path, 'pvHeaderBox', 'pvBodyBox');
      } else {
        highlightSelectedDom();
      }
    }
  }

  function renderPlateCard(f, isSub, allowCompare) {
    const thumb = 'https://hub.local/api/thumb?path=' + encodeURIComponent(f.path);
    const tagText = isSub ? (f.figPanel ? `Panel ${f.figPanel}` : '单图') : (f.dimMm || 'A4 PDF');
    return `
      <div class="plate-card ${f.path === STATE.selectedPath ? 'selected' : ''}" data-fpath="${escAttr(f.path)}"
           onclick="selectFileForPreview('${escAttr(f.path)}','pvHeaderBox','pvBodyBox')"
           ondblclick="openDeliverable('${escAttr(f.path)}')">
        <div class="plate-artboard">
          <span class="plate-tag">${esc(tagText)}</span>
          ${allowCompare ? `<button class="plate-cmp-btn" onclick="event.stopPropagation();openCompareWithTarget('${escAttr(f.path)}')">对比</button>` : ''}
          <img src="${thumb}" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
          <div class="plate-typo-fallback">
            <div style="font-weight:700;font-size:13.5px;">${esc(f.figGroup || 'PDF')}</div>
            <div class="meta-caption" style="font-size:12px;">${esc(f.dimMm || f.ext.toUpperCase())}</div>
          </div>
        </div>
        <div class="plate-cap">
          <div class="plate-name" title="${escAttr(f.name)}">${esc(f.name)}</div>
          <div class="plate-sub meta-caption num"><span>${formatFileSize(f.sizeMb)}</span><span>${esc(f.hmStr)}</span></div>
        </div>
      </div>
    `;
  }

  function renderDocRow(f, badge, isPrimary) {
    const subPrefix = (f.displayTitle && f.displayTitle !== f.name) ? (esc(f.name) + ' / ') : '';
    return `
      <div class="doc-row ${f.path === STATE.selectedPath ? 'selected' : ''}" data-fpath="${escAttr(f.path)}"
           onclick="selectFileForPreview('${escAttr(f.path)}','pvHeaderBox','pvBodyBox')"
           ondblclick="openDeliverable('${escAttr(f.path)}')">
        <span class="kind-pill ${isPrimary ? 'primary' : ''}">${esc(badge)}</span>
        <div style="min-width:0;">
          <div class="doc-title">${esc(f.displayTitle)}</div>
          <div class="doc-sub meta-caption num">${subPrefix}${formatFileSize(f.sizeMb)} / ${esc(f.date)}</div>
        </div>
        <div class="doc-actions" onclick="event.stopPropagation()">
          <button class="deliv-btn sm ${isPrimary ? 'primary' : ''}" onclick="openDeliverable('${escAttr(f.path)}')">打开</button>
          <button class="deliv-btn sm ghost" onclick="revealInExplorer('${escAttr(f.path)}')">定位</button>
        </div>
      </div>
    `;
  }

  function toggleBatchExpand(bk) {
    if (EXPANDED_BATCHES.has(bk)) EXPANDED_BATCHES.delete(bk);
    else EXPANDED_BATCHES.add(bk);
    // For top-2 default-expanded batches, toggle collapsed class directly if present
    renderBatchStageOnly();
  }
  function expandSubpanels(bk) { EXPANDED_SUBPANELS.add(bk); renderBatchStageOnly(); }

  function findBatchByKey(bk) {
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    if (!tEntry) return null;
    const fgObj = tEntry.figMap.get(STATE.figGroup);
    return fgObj ? fgObj.batches.find(b => b.batchKey === bk) : null;
  }

  function copyBatchPaths(bk) {
    const b = findBatchByKey(bk);
    if (!b) return;
    const core = b.lanes.html.concat(b.lanes.a4, b.lanes.other.filter(x => x.ftype === 'pptx'));
    const list = (core.length ? core : b.items).map(x => x.path);
    copyText(list.join('\n'), `已复制本轮 ${list.length} 份核心文件绝对路径`);
  }

  function exportBatchZip(bk) {
    const b = findBatchByKey(bk);
    if (!b) return;
    const core = b.lanes.html.slice(0, 2).concat(b.lanes.a4.slice(0, 10), b.lanes.other.filter(x => x.ftype === 'pptx' || x.ftype === 'doc').slice(0, 4));
    const list = (core.length ? core : b.items.slice(0, 16)).map(x => x.path);
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    const title = `${cleanLabel(tEntry.topic.short)}_${STATE.figGroup}_${b.dayStr}_定稿包`;
    nativeCall('exportBatchZip', { title, paths: list });
  }

  function triggerBatchAiSummary(bk, hash, prevDesc, currDesc) {
    const btn = document.getElementById('aiBtn_' + hash);
    if (btn) { btn.textContent = '精炼中…'; btn.disabled = true; }
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    nativeCall('requestMicroSummary', {
      batchKey: bk, hash,
      topicName: tEntry ? cleanLabel(tEntry.topic.short) : '',
      figGroup: STATE.figGroup,
      prevDesc, currDesc
    });
  }

  // =========================================================
  // QUICKLOOK PREVIEW FOLIO & SPACEBAR LIGHTBOX
  // =========================================================
  function highlightSelectedDom() {
    document.querySelectorAll('[data-fpath]').forEach(el => el.classList.toggle('selected', el.getAttribute('data-fpath') === STATE.selectedPath));
  }

  function mountInlineLivePreview(fp, mode, bodyId) {
    const box = document.getElementById(bodyId || 'pvBodyBox');
    const rawUrl = 'https://hub.local/rawfile?path=' + encodeURIComponent(fp);
    if (mode === 'pdf') box.innerHTML = `<iframe class="pv-iframe" src="${rawUrl}#view=FitH&toolbar=0&navpanes=0"></iframe>`;
    else box.innerHTML = `<iframe class="pv-iframe" sandbox="allow-same-origin allow-scripts" src="${rawUrl}"></iframe>`;
  }

  async function selectFileForPreview(fp, headId, bodyId) {
    STATE.selectedPath = fp;
    highlightSelectedDom();
    const headBox = document.getElementById(headId || 'pvHeaderBox');
    const bodyBox = document.getElementById(bodyId || 'pvBodyBox');
    if (!headBox || !bodyBox) return;

    const item = ALL_FILES.find(x => x.path === fp);
    const title = item ? item.displayTitle : fp.split('\\').pop();
    const ext = (fp.includes('.') ? '.' + fp.split('.').pop() : '').toLowerCase();
    const isVisual = ['.pdf', '.png', '.jpg', '.jpeg', '.svg', '.webp'].includes(ext);

    headBox.innerHTML = `
      <div class="pv-title">${esc(title)}</div>
      <div class="pv-path meta-caption">${esc(fp)}</div>
      <div class="pv-btn-row">
        <button class="deliv-btn sm primary" onclick="openDeliverable('${escAttr(fp)}')">打开原件</button>
        ${isVisual ? `<button class="deliv-btn sm" onclick="openLightbox('${escAttr(fp)}')">全屏灯箱</button>` : ''}
        ${ext === '.html' || ext === '.htm' ? `<button class="deliv-btn sm" onclick="mountInlineLivePreview('${escAttr(fp)}','html','${escAttr(bodyId || 'pvBodyBox')}')">内嵌网页</button>` : ''}
        ${ext === '.pdf' ? `<button class="deliv-btn sm" onclick="mountInlineLivePreview('${escAttr(fp)}','pdf','${escAttr(bodyId || 'pvBodyBox')}')">多页阅读</button>` : ''}
        <button class="deliv-btn sm" onclick="revealInExplorer('${escAttr(fp)}')">定位</button>
        <button class="deliv-btn sm" onclick="copyText('${escAttr(fp)}','已复制绝对路径')">复制路径</button>
      </div>
    `;

    const rawUrl = 'https://hub.local/rawfile?path=' + encodeURIComponent(fp);
    if (ext === '.pdf') {
      const hiThumb = 'https://hub.local/api/thumb?hi=1&path=' + encodeURIComponent(fp);
      bodyBox.innerHTML = `<div class="pv-img-box" onclick="this.classList.toggle('zoomed')" title="单击切换 100% 放大，按 Space 开全屏灯箱"><img src="${hiThumb}" alt="" onerror="mountInlineLivePreview('${escAttr(fp)}','pdf','${escAttr(bodyId || 'pvBodyBox')}')"></div>`;
      return;
    }
    if (['.png', '.jpg', '.jpeg', '.svg', '.webp', '.gif'].includes(ext)) {
      bodyBox.innerHTML = `<div class="pv-img-box" onclick="this.classList.toggle('zoomed')"><img src="${rawUrl}" alt=""></div>`;
      return;
    }

    bodyBox.innerHTML = `<div style="padding:36px;text-align:center;color:var(--ink-3);font-size:14px;">正在读取导览…</div>`;
    try {
      const res = await fetch('https://hub.local/api/preview-info?path=' + encodeURIComponent(fp));
      const info = await res.json();
      if (STATE.selectedPath !== fp) return;
      if (!info.ok) { bodyBox.innerHTML = `<div style="padding:36px;text-align:center;color:var(--ink-3);">${esc(info.error || '无法读取')}</div>`; return; }

      if (info.mode === 'html_dossier') {
        const heads = info.headings || [], vsibs = info.visual_siblings || [];
        bodyBox.innerHTML = `
          <div class="pv-dossier">
            <div class="pv-dossier-card">
              <div class="pv-dossier-h">交互式审阅报告导览（${info.size_mb} MB）</div>
              <div style="font-size:15px;font-weight:700;color:var(--ink-1);line-height:1.45;">${esc(info.html_title || info.name)}</div>
              ${info.excerpt ? `<div style="font-size:14px;color:var(--ink-2);margin-top:7px;line-height:1.58;">${esc(info.excerpt)}</div>` : ''}
              <div style="margin-top:11px;display:flex;gap:8px;flex-wrap:wrap;">
                <button class="deliv-btn sm primary" onclick="openDeliverable('${escAttr(fp)}')">浏览器全屏打开</button>
                <button class="deliv-btn sm" onclick="mountInlineLivePreview('${escAttr(fp)}','html','${escAttr(bodyId || 'pvBodyBox')}')">阅览席内嵌渲染</button>
              </div>
            </div>
            ${vsibs.length ? `
              <div class="pv-dossier-card">
                <div class="pv-dossier-h">同目录配套组图（单击看大图）</div>
                <div class="pv-mini-grid">
                  ${vsibs.slice(0, 4).map(v => `
                    <div class="pv-mini-plate" onclick="selectFileForPreview('${escAttr(v.path)}','${escAttr(headId || 'pvHeaderBox')}','${escAttr(bodyId || 'pvBodyBox')}')">
                      <div class="pv-mini-art"><img src="https://hub.local/api/thumb?path=${encodeURIComponent(v.path)}" alt="" onerror="this.style.display='none'"></div>
                      <div class="pv-mini-cap meta-caption">${esc(v.name)}</div>
                    </div>
                  `).join('')}
                </div>
              </div>
            ` : ''}
            ${heads.length ? `
              <div class="pv-dossier-card">
                <div class="pv-dossier-h">章节提纲</div>
                ${heads.map(h => `<div class="pv-toc-item">${esc(h)}</div>`).join('')}
              </div>
            ` : ''}
          </div>
        `;
      } else if (info.mode === 'text') {
        if (ext === '.md' || ext === '.markdown') {
          bodyBox.innerHTML = renderCleanMarkdown(info.content || '');
        } else {
          bodyBox.innerHTML = `<div class="pv-text-pre">${esc(info.content || '')}</div>`;
        }
      } else if (info.mode === 'table') {
        const rows = info.rows || [];
        bodyBox.innerHTML = rows.length
          ? `<div style="overflow:auto;flex:1;"><table class="pv-table"><thead><tr>${rows[0].map(c => `<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${rows.slice(1).map(r => `<tr>${r.map(c => `<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`
          : `<div style="padding:36px;text-align:center;color:var(--ink-3);">空数据表</div>`;
      } else if (info.mode === 'zip') {
        bodyBox.innerHTML = `<div class="pv-dossier-card"><div class="pv-dossier-h">归档包共 ${info.zip_total} 个文件（${info.size_mb} MB）</div>${(info.zip_entries || []).map(e => `<div class="pv-toc-item" style="display:flex;justify-content:space-between;"><span>${esc(e.name)}</span><span class="meta-caption num">${e.kb} KB</span></div>`).join('')}</div>`;
      } else {
        bodyBox.innerHTML = `
          <div class="pv-dossier-card">
            <div style="font-size:15px;font-weight:700;margin-bottom:6px;">${esc(info.name)}</div>
            <div class="meta-caption num" style="font-size:13.5px;color:var(--ink-2);">体积 ${info.size_mb} MB / 修改于 ${esc(info.date)}</div>
            <div style="margin-top:12px;"><button class="deliv-btn primary" onclick="openDeliverable('${escAttr(fp)}')">调用系统程序打开原件</button></div>
          </div>
        `;
      }
    } catch (_) {
      bodyBox.innerHTML = `<div style="padding:36px;text-align:center;color:var(--ink-3);">请点击上方「打开原件」查看</div>`;
    }
  }

  function openLightbox(fp) {
    const visuals = CURRENT_BATCH_FILES.filter(x => x.lane === 'a4' || x.lane === 'single');
    STATE.lbPool = visuals.length ? visuals : [{ path: fp, name: fp.split('\\').pop(), dimMm: '', date: '' }];
    let idx = STATE.lbPool.findIndex(x => x.path === fp);
    if (idx < 0) { STATE.lbPool.unshift({ path: fp, name: fp.split('\\').pop(), dimMm: '', date: '' }); idx = 0; }
    STATE.lbIndex = idx;
    renderLightboxItem();
    document.getElementById('lightboxModal').classList.add('open');
    syncModalLintMask();
  }
  function closeLightbox() { document.getElementById('lightboxModal').classList.remove('open'); syncModalLintMask(); }
  function stepLightbox(delta) {
    if (!STATE.lbPool.length) return;
    STATE.lbIndex = (STATE.lbIndex + delta + STATE.lbPool.length) % STATE.lbPool.length;
    renderLightboxItem();
  }
  function renderLightboxItem() {
    const it = STATE.lbPool[STATE.lbIndex];
    if (!it) return;
    document.getElementById('lbTitle').textContent = `${it.name} (${STATE.lbIndex + 1}/${STATE.lbPool.length})`;
    document.getElementById('lbSub').textContent = `${it.dimMm ? it.dimMm + ' / ' : ''}${it.date || ''} / ${it.path}`;
    document.getElementById('lbOpenBtn').onclick = () => openDeliverable(it.path);
    const ext = (it.path.split('.').pop() || '').toLowerCase();
    const imgSrc = ext === 'pdf'
      ? ('https://hub.local/api/thumb?hi=1&path=' + encodeURIComponent(it.path))
      : ('https://hub.local/rawfile?path=' + encodeURIComponent(it.path));
    document.getElementById('lbBody').innerHTML = `<img src="${imgSrc}" alt="">`;
  }

  // =========================================================
  // A/B VISUAL DIFF LOUPE (Curtain Wipe + Side-by-Side Sync)
  // =========================================================
  function openCompareForCurrentFig(targetPath) {
    const tEntry = TOPIC_TREE_V4[STATE.topicId];
    if (!tEntry) return;
    const fgObj = tEntry.figMap.get(STATE.figGroup);
    if (!fgObj || fgObj.visualPool.length < 2) { showToast('当前 Fig 需至少 2 轮视觉版本方可对比'); return; }

    STATE.cmpPool = fgObj.visualPool;
    const selA = document.getElementById('cmpSelectA');
    const selB = document.getElementById('cmpSelectB');
    const opts = STATE.cmpPool.map((v, i) => `<option value="${i}">${esc(v.label)}</option>`).join('');
    selA.innerHTML = opts;
    selB.innerHTML = opts;

    // Default: B = newest (0), A = previous (1)
    let idxB = 0, idxA = 1;
    if (targetPath) {
      const ti = STATE.cmpPool.findIndex(v => v.path === targetPath);
      if (ti >= 0) {
        idxB = ti;
        idxA = (ti + 1 < STATE.cmpPool.length) ? ti + 1 : 0;
      }
    }
    selA.value = String(idxA);
    selB.value = String(idxB);

    document.getElementById('cmpModalTitle').textContent = `${cleanLabel(tEntry.topic.short)} / ${fgObj.figGroup} 新旧组图 A/B 对比镜`;
    document.getElementById('compareModal').classList.add('open');
    syncModalLintMask();
    renderCompareStage();
  }
  function openCompareWithTarget(fp) { openCompareForCurrentFig(fp); }
  function closeCompareModal() { document.getElementById('compareModal').classList.remove('open'); syncModalLintMask(); }
  function setCompareMode(m) {
    STATE.cmpMode = m;
    document.getElementById('btnCmpModeCurtain').classList.toggle('active', m === 'curtain');
    document.getElementById('btnCmpModeSbs').classList.toggle('active', m === 'sbs');
    renderCompareStage();
  }
  function setCmpZoom(z) {
    STATE.cmpZoom = z;
    document.querySelectorAll('#cmpZoomBar .type-chip').forEach(b => b.classList.toggle('active', parseFloat(b.getAttribute('data-z')) === z));
    renderCompareStage();
  }

  function visualSrcForPath(fp) {
    const ext = (fp.split('.').pop() || '').toLowerCase();
    return ext === 'pdf'
      ? ('https://hub.local/api/thumb?hi=1&path=' + encodeURIComponent(fp))
      : ('https://hub.local/rawfile?path=' + encodeURIComponent(fp));
  }

  function renderCompareStage() {
    const a = STATE.cmpPool[parseInt(document.getElementById('cmpSelectA').value || '1', 10)] || STATE.cmpPool[1];
    const b = STATE.cmpPool[parseInt(document.getElementById('cmpSelectB').value || '0', 10)] || STATE.cmpPool[0];
    if (!a || !b) return;
    const srcA = visualSrcForPath(a.path), srcB = visualSrcForPath(b.path);
    const stage = document.getElementById('cmpStageBox');
    const ribbon = document.getElementById('cmpMetaRibbon');

    const sizeDelta = (b.sizeMb - a.sizeMb);
    const deltaStr = Math.abs(sizeDelta) >= 0.01 ? `${sizeDelta > 0 ? '+' : ''}${sizeDelta.toFixed(2)} MB` : '体积相近';
    if (ribbon) {
      ribbon.innerHTML = `
        <span><strong>旧版 A：</strong>${esc(a.date)} / ${esc(a.dimMm || 'PDF')} / ${formatFileSize(a.sizeMb)}</span>
        <span class="meta-caption num" style="color:var(--fresh-ink);font-weight:700;">对比变化：${esc(deltaStr)}</span>
        <span><strong>新版 B：</strong>${esc(b.date)} / ${esc(b.dimMm || 'PDF')} / ${formatFileSize(b.sizeMb)}</span>
      `;
    }

    stage.classList.toggle('zoomed-stage', STATE.cmpZoom > 1);

    if (STATE.cmpMode === 'curtain') {
      const imgStyle = STATE.cmpZoom > 1
        ? `max-height:none;max-width:none;height:${Math.round(74 * STATE.cmpZoom)}vh;`
        : '';
      stage.innerHTML = `
        <div class="curtain-wrap" id="curtainWrap" onpointerdown="startCurtainDrag(event)">
          <img class="curtain-img-base" src="${srcB}" style="${imgStyle}" alt="">
          <div class="curtain-overlay" id="curtainOverlay" style="clip-path:inset(0 ${100 - STATE.cmpPos}% 0 0);">
            <img src="${srcA}" alt="">
          </div>
          <div class="curtain-line" id="curtainLine" style="left:${STATE.cmpPos}%;">
            <div class="curtain-knob">⇄</div>
          </div>
        </div>
      `;
    } else {
      const zStyle = STATE.cmpZoom > 1 ? `max-width:none;max-height:none;width:${Math.round(STATE.cmpZoom * 100)}%;` : '';
      stage.innerHTML = `
        <div class="sbs-grid">
          <div class="sbs-pane">
            <div class="sbs-head"><span>旧版 A / ${esc(a.date)}</span><span class="meta-caption num">${esc(a.dimMm || '')} ${formatFileSize(a.sizeMb)}</span></div>
            <div class="sbs-body"><img src="${srcA}" style="${zStyle}" alt=""></div>
          </div>
          <div class="sbs-pane">
            <div class="sbs-head"><span>新版 B / ${esc(b.date)}</span><span class="meta-caption num">${esc(b.dimMm || '')} ${formatFileSize(b.sizeMb)}</span></div>
            <div class="sbs-body"><img src="${srcB}" style="${zStyle}" alt=""></div>
          </div>
        </div>
      `;
    }
  }

  function startCurtainDrag(e) {
    const wrap = document.getElementById('curtainWrap');
    if (!wrap) return;
    const updateAt = (clientX) => {
      const r = wrap.getBoundingClientRect();
      const pct = Math.max(4, Math.min(96, ((clientX - r.left) / Math.max(1, r.width)) * 100));
      STATE.cmpPos = pct;
      const ov = document.getElementById('curtainOverlay');
      const ln = document.getElementById('curtainLine');
      if (ov) ov.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      if (ln) ln.style.left = pct + '%';
    };
    updateAt(e.clientX);
    const onMove = (ev) => updateAt(ev.clientX);
    const onUp = () => { window.removeEventListener('pointermove', onMove); window.removeEventListener('pointerup', onUp); };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  }

  // =========================================================
  // VIEW 2: REAL FOLDER BROWSER
  // =========================================================
  async function loadFolderBrowser(dirPath) {
    try {
      const res = await fetch('https://hub.local/api/folder-list?path=' + encodeURIComponent(dirPath || ''));
      FOLDER_VIEW_DATA = await res.json();
      if (FOLDER_VIEW_DATA && FOLDER_VIEW_DATA.ok) STATE.folderPath = FOLDER_VIEW_DATA.path;
    } catch (_) {}
    renderFolderBrowser();
  }
  function goParentFolder() { if (FOLDER_VIEW_DATA && FOLDER_VIEW_DATA.parent) loadFolderBrowser(FOLDER_VIEW_DATA.parent); }
  function openCurrentFolderInExplorer() { if (FOLDER_VIEW_DATA && FOLDER_VIEW_DATA.path) nativeCall('openFolder', { path: FOLDER_VIEW_DATA.path }); }

  function renderFolderBrowser() {
    const fd = FOLDER_VIEW_DATA || { path: HUB ? HUB.root_path : '', dirs: [], files: [], root_dirs: [], is_root: true };
    const rail = document.getElementById('folderRailScroll');
    const curLow = String(fd.path || '').toLowerCase();
    rail.innerHTML = `<div class="fig-sec-lbl">平台与根目录</div>` +
      `<button class="fig-nav-btn ${fd.is_root ? 'active' : ''}" onclick="loadFolderBrowser('${escAttr(HUB ? HUB.root_path : '')}')"><span class="fig-nav-name">输出总根目录</span></button>` +
      (fd.root_dirs || []).map(rd => `
        <button class="fig-nav-btn ${curLow.startsWith(String(rd.path || '').toLowerCase()) ? 'active' : ''}" onclick="loadFolderBrowser('${escAttr(rd.path)}')">
          <span class="fig-nav-name">${esc(rd.name)}</span>
        </button>
      `).join('');

    const fn = (fd.path || '').replace(/[\\/]+$/, '').split(/[\\/]/).pop() || '输出根目录';
    document.getElementById('folderCenterTitle').textContent = fn;
    document.getElementById('folderCenterPath').textContent = fd.path || '';
    document.getElementById('btnFolderUp').style.display = fd.parent ? 'inline-flex' : 'none';

    let html = '';
    const folderSvg = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--fresh-ink)" stroke-width="1.9"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
    if ((fd.dirs || []).length) {
      html += `<div class="doc-list">` + fd.dirs.map(d => `
        <div class="doc-row" style="grid-template-columns:36px minmax(0,1fr) auto;" onclick="loadFolderBrowser('${escAttr(d.path)}')">
          <span style="display:flex;align-items:center;justify-content:center;">${folderSvg}</span>
          <div style="min-width:0;"><div class="doc-title">${esc(d.name)}</div><div class="doc-sub meta-caption num">更新于 ${esc(d.date)}</div></div>
          <div class="doc-actions" onclick="event.stopPropagation()"><button class="deliv-btn sm ghost" onclick="loadFolderBrowser('${escAttr(d.path)}')">进入</button></div>
        </div>
      `).join('') + `</div>`;
    }
    if ((fd.files || []).length) {
      html += `<div class="doc-list">` + fd.files.map(f => `
        <div class="doc-row ${f.path === STATE.selectedPath ? 'selected' : ''}" data-fpath="${escAttr(f.path)}" onclick="selectFileForPreview('${escAttr(f.path)}','fpvHeaderBox','fpvBodyBox')" ondblclick="openDeliverable('${escAttr(f.path)}')">
          <span class="kind-pill">${esc((f.ext || '').replace('.', '').toUpperCase() || 'FILE')}</span>
          <div style="min-width:0;"><div class="doc-title">${esc(f.name)}</div><div class="doc-sub meta-caption num">${formatFileSize(f.size_mb)} / ${esc(f.date)}</div></div>
          <div class="doc-actions" onclick="event.stopPropagation()"><button class="deliv-btn sm ghost" onclick="openDeliverable('${escAttr(f.path)}')">打开</button></div>
        </div>
      `).join('') + `</div>`;
    }
    document.getElementById('folderCenterScroll').innerHTML = html || `<div style="padding:48px;text-align:center;color:var(--ink-3);">此文件夹为空</div>`;
    if (fd.files && fd.files.length) selectFileForPreview(fd.files[0].path, 'fpvHeaderBox', 'fpvBodyBox');
    else {
      document.getElementById('fpvHeaderBox').innerHTML = `<div class="pv-title">${esc(fn)}</div><div class="pv-path meta-caption">${esc(fd.path || '')}</div>`;
      document.getElementById('fpvBodyBox').innerHTML = `<div style="padding:36px;color:var(--ink-2);font-size:14px;">含 ${(fd.dirs || []).length} 个子文件夹，单击左侧目录继续深入浏览。</div>`;
    }
  }

  // =========================================================
  // VIEW 3: FOCUSED LINEAGE MIND-MAP
  // =========================================================
  function toggleAllMmExpand() { STATE.mmExpandAll = !STATE.mmExpandAll; renderLineage(); setTimeout(drawMindmapWires, 30); }
  function renderLineage() {
    if (!HUB || !HUB.topics || !HUB.topics.length) return;
    const curTopic = HUB.topics.find(t => t.id === STATE.lineageTopicId) || HUB.topics[0];
    STATE.lineageTopicId = curTopic.id;
    document.getElementById('lineageRailScroll').innerHTML = HUB.topics.map(t => `
      <button class="fig-nav-btn ${t.id === curTopic.id ? 'active' : ''}" onclick="STATE.lineageTopicId='${escAttr(t.id)}';renderLineage();setTimeout(drawMindmapWires,30);">
        <span class="fig-nav-name">${esc(cleanLabel(t.short))}</span>
        <span class="fig-nav-badge num">${t.project_count}</span>
      </button>
    `).join('');

    document.getElementById('mmTopicTitle').textContent = `${cleanLabel(curTopic.short)}（${curTopic.project_count} 个阶段目录）`;
    document.getElementById('mmTopicDesc').textContent = curTopic.title || '';
    document.getElementById('btnMmExpandAll').textContent = STATE.mmExpandAll ? '收起早期历史' : '展开全部历史版本';

    document.getElementById('mmColRoot').innerHTML = `
      <div class="mm-root-node" id="mmRootCard">
        <div style="font-size:16.5px;font-weight:700;">${esc(cleanLabel(curTopic.short))}</div>
        <div class="meta-caption num" style="font-size:12.5px;opacity:0.88;margin-top:6px;">${(curTopic.branches || []).length} 条分支 / ${curTopic.a4_pdf_count || 0} A4 / ${curTopic.html_count || 0} 报告</div>
      </div>
    `;

    const bHtml = [], lHtml = [];
    (curTopic.branches || []).forEach((b, bi) => {
      const bId = `mm_b_${bi}`, gId = `mm_g_${bi}`;
      bHtml.push(`<div class="mm-branch-node" id="${bId}"><div style="font-size:14.5px;font-weight:700;color:var(--ink-1);">${esc(b.name.replace(/^\d+_/, ''))}</div><div class="meta-caption num" style="font-size:12px;color:var(--ink-3);margin-top:3px;">${b.count} 个阶段版本</div></div>`);
      const vis = STATE.mmExpandAll ? b.projects : b.projects.slice(0, 4);
      lHtml.push(`<div class="mm-leaf-group" id="${gId}">` + vis.map(p => `
        <div class="mm-leaf-node" onclick="enterTopic('${escAttr(curTopic.id)}')">
          <div style="display:flex;justify-content:space-between;gap:8px;"><span style="font-size:14px;font-weight:700;color:var(--ink-1);">${esc(p.name)}</span><span class="meta-caption num" style="font-size:12px;color:var(--fresh-ink);flex-shrink:0;">${esc(p.date)}</span></div>
          <div class="meta-caption" style="font-size:12.5px;color:var(--ink-3);margin-top:4px;">${esc(cleanLabel(p.change_hint || ''))}</div>
        </div>
      `).join('') + `</div>`);
    });
    document.getElementById('mmColBranches').innerHTML = bHtml.join('');
    document.getElementById('mmColLeaves').innerHTML = lHtml.join('');
  }

  function drawMindmapWires() {
    const svg = document.getElementById('mmSvg'), canvas = document.getElementById('mmCanvas'), root = document.getElementById('mmRootCard');
    if (!svg || !canvas || !root) return;
    const cr = canvas.getBoundingClientRect();
    const rr = root.getBoundingClientRect();
    const rx = rr.right - cr.left, ry = rr.top + rr.height / 2 - cr.top;
    const paths = [];
    document.querySelectorAll('[id^="mm_b_"]').forEach((bn, i) => {
      const br = bn.getBoundingClientRect();
      const bx1 = br.left - cr.left, by = br.top + br.height / 2 - cr.top, bx2 = br.right - cr.left;
      const mx = (rx + bx1) / 2;
      paths.push(`<path d="M ${rx} ${ry} C ${mx} ${ry}, ${mx} ${by}, ${bx1} ${by}" fill="none" stroke="var(--line-strong)" stroke-width="1.6"/>`);
      const grp = document.getElementById('mm_g_' + i);
      if (grp) {
        grp.querySelectorAll('.mm-leaf-node').forEach(lf => {
          const lr = lf.getBoundingClientRect();
          const lx = lr.left - cr.left, ly = lr.top + lr.height / 2 - cr.top;
          const m2 = (bx2 + lx) / 2;
          paths.push(`<path d="M ${bx2} ${by} C ${m2} ${by}, ${m2} ${ly}, ${lx} ${ly}" fill="none" stroke="var(--line-soft)" stroke-width="1.3"/>`);
        });
      }
    });
    svg.innerHTML = paths.join('');
  }

  // =========================================================
  // GLOBAL OMNI SEARCH MODAL
  // =========================================================
  function openSearchModal(initText) {
    document.getElementById('searchModal').classList.add('open');
    syncModalLintMask();
    const inp = document.getElementById('omniSearchInput');
    if (typeof initText === 'string') inp.value = initText;
    document.getElementById('topSearchTrigger').value = '';
    setTimeout(() => { inp.focus(); inp.select(); onOmniSearchInput(); }, 20);
  }
  function closeSearchModal() { document.getElementById('searchModal').classList.remove('open'); syncModalLintMask(); }

  function onOmniSearchInput() {
    const q = (document.getElementById('omniSearchInput').value || '').trim().toLowerCase();
    renderSearchResults(q);
    clearTimeout(LIVE_SEARCH_TIMER);
    if (q.length >= 2) {
      LIVE_SEARCH_TIMER = setTimeout(async () => {
        try {
          const res = await fetch('https://hub.local/api/live-search?q=' + encodeURIComponent(q));
          const data = await res.json();
          LIVE_SEARCH_ITEMS = data.items || [];
          renderSearchResults((document.getElementById('omniSearchInput').value || '').trim().toLowerCase());
        } catch (_) {}
      }, 160);
    } else {
      LIVE_SEARCH_ITEMS = [];
    }
  }

  function renderSearchResults(q) {
    const box = document.getElementById('omniSearchResults');
    const toks = q.split(/\s+/).filter(Boolean);
    let hits = [];
    if (!toks.length) {
      hits = ALL_FILES.slice(0, 18);
    } else {
      const seen = new Set();
      ALL_FILES.forEach(f => {
        const hay = `${f.name} ${f.displayTitle} ${f.projName} ${f.topicShort} ${f.figGroup} ${f.rel}`.toLowerCase();
        if (toks.every(t => hay.includes(t))) {
          seen.add(f.path.toLowerCase());
          hits.push(f);
        }
      });
      LIVE_SEARCH_ITEMS.forEach(lf => {
        if (!seen.has(String(lf.path || '').toLowerCase())) {
          hits.push({ name: lf.name, displayTitle: lf.name, path: lf.path, topicId: '', topicShort: '全盘命中', figGroup: '', date: lf.date || '', projName: lf.proj_name || '' });
        }
      });
      hits = hits.slice(0, 45);
    }

    box.innerHTML = hits.map(f => `
      <div class="search-hit" onclick="jumpFromSearch('${escAttr(f.topicId || '')}','${escAttr(f.figGroup || '')}','${escAttr(f.path)}')">
        <div style="min-width:0;">
          <div style="font-size:14px;font-weight:600;color:var(--ink-1);overflow-wrap:anywhere;">${esc(f.displayTitle)}</div>
          <div class="meta-caption num" style="font-size:12px;color:var(--ink-3);">${esc(f.topicShort || '本地')} / ${esc(f.figGroup || f.projName)} / ${esc(f.date || '')}</div>
        </div>
        <div style="display:flex;gap:6px;flex-shrink:0;" onclick="event.stopPropagation()">
          <button class="deliv-btn sm primary" onclick="openDeliverable('${escAttr(f.path)}')">打开</button>
          <button class="deliv-btn sm" onclick="revealInExplorer('${escAttr(f.path)}')">定位</button>
        </div>
      </div>
    `).join('') || `<div style="padding:32px;text-align:center;color:var(--ink-3);">未找到匹配文件</div>`;
  }

  function jumpFromSearch(topicId, figGroup, fp) {
    closeSearchModal();
    if (topicId && TOPIC_TREE_V4[topicId]) {
      enterTopic(topicId, figGroup);
      selectFileForPreview(fp, 'pvHeaderBox', 'pvBodyBox');
    } else {
      openDeliverable(fp);
    }
  }

  // =========================================================
  // VIEW 4: SETTINGS, AUTO-UPDATE & LIGHTWEIGHT AI CONFIG
  // =========================================================
  async function renderSettingsView() {
    if (!HUB) return;
    const s = HUB.summary || {};
    document.getElementById('setVerLine').textContent = `当前版本：v${APP_INFO.version || '4.0.0'}（纯离线单文件）`;
    document.getElementById('setExePathLine').textContent = APP_INFO.exe_path ? `程序路径：${APP_INFO.exe_path}` : '';
    document.getElementById('storageDetailText').textContent =
      `当前纳管 ${s.total_projects || 0} 个阶段目录、共 ${ALL_FILES.length.toLocaleString()} 份核心文件，总体积 ${(s.total_size_gb || 0).toFixed(2)} GB（含约 ${(s.total_cache_gb || 0).toFixed(2)} GB 中间缓存）。`;

    const lockedProjs = (HUB.projects || []).filter(p => p.locked).slice(0, 8);
    document.getElementById('guideLiveList').innerHTML = lockedProjs.length
      ? lockedProjs.map(p => `<div style="padding:9px 12px;border-radius:10px;background:var(--bg-elevated);font-size:13px;"><div style="font-weight:700;color:var(--ink-1);">${esc(p.name)}</div><div class="meta-caption" style="font-size:12px;color:var(--ink-3);">${esc((p.lock_reasons || []).join(' / '))}</div></div>`).join('')
      : `<div style="padding:12px;border-radius:10px;background:var(--bg-elevated);font-size:13.5px;color:var(--ink-2);">当前无活跃写入锁定目录，可随时安全整理。</div>`;

    try {
      const r = await fetch('https://hub.local/api/llm-config');
      const cfg = await r.json();
      document.getElementById('llmEnabledChk').checked = Boolean(cfg.enabled);
      document.getElementById('llmBaseUrl').value = cfg.base_url || 'https://api.openai.com/v1';
      document.getElementById('llmModel').value = cfg.model || 'gpt-4o-mini';
      document.getElementById('llmApiKey').value = cfg.key_masked || '';
      document.getElementById('llmKeyHint').textContent = cfg.has_key ? `已安全保存本地密钥（${cfg.key_masked}）` : '尚未配置 API Key（默认 0 费用纯本地运行）';
    } catch (_) {}
  }

  function saveLlmSettings() {
    nativeCall('saveLlmConfig', {
      enabled: document.getElementById('llmEnabledChk').checked,
      base_url: document.getElementById('llmBaseUrl').value.trim(),
      model: document.getElementById('llmModel').value.trim(),
      api_key: document.getElementById('llmApiKey').value.trim()
    });
  }

  async function checkGithubUpdate(showUserFeedback) {
    const stEl = document.getElementById('setUpdateStatus');
    if (showUserFeedback && stEl) stEl.textContent = '正在连接 GitHub Releases 检查最新版…';
    try {
      const res = await fetch('https://hub.local/api/update-check');
      const info = await res.json();
      UPDATE_INFO = info;
      if (info.ok && info.has_update && info.download_url) {
        document.getElementById('btnTopUpdate').classList.add('show');
        document.getElementById('topUpdateLabel').textContent = `新版 v${info.latest}`;
        if (stEl) stEl.textContent = `发现新版本 v${info.latest}（${info.asset_size_mb || 1.2} MB），支持一键无缝热更新`;
        const b2 = document.getElementById('btnSettingsApplyUpd');
        if (b2) b2.style.display = 'inline-flex';
        if (showUserFeedback) showToast(`发现新版 v${info.latest}，可点击一键热更新`);
      } else if (info.ok) {
        if (stEl) stEl.textContent = `已是最新版本（v${info.current}）`;
        if (showUserFeedback) showToast(`当前已是最新版本 v${info.current}`);
      } else {
        if (stEl) stEl.textContent = `当前处于纯离线环境（所有本地功能 100% 可用）`;
        if (showUserFeedback) showToast('当前无法连接 GitHub，已保持纯离线模式');
      }
    } catch (_) {
      if (stEl) stEl.textContent = '当前处于纯离线环境（所有本地功能 100% 可用）';
    }
  }

  function triggerAutoUpdate() {
    if (!UPDATE_INFO || !UPDATE_INFO.download_url) { checkGithubUpdate(true); return; }
    showToast(`正在下载 v${UPDATE_INFO.latest} 并校验完整性…`);
    nativeCall('applyUpdate', { download_url: UPDATE_INFO.download_url, latest: UPDATE_INFO.latest });
  }

  function triggerRefresh() { showToast('正在重新扫描本地目录…'); nativeCall('runRefresh'); }
  function triggerSafeTidy() { showToast('正在后台执行无损增量归整…'); nativeCall('runTidy'); }

  // Host async callbacks
  window.__onUpdateStatus = function(st) {
    showToast(st.message || '更新状态变更');
    const el = document.getElementById('setUpdateStatus');
    if (el && st.message) el.textContent = st.message;
  };
  window.__onLlmConfigSaved = function(cfg) {
    APP_INFO.llm_enabled = Boolean(cfg.enabled && cfg.has_key);
    document.getElementById('llmKeyHint').textContent = cfg.has_key ? `已保存密钥（${cfg.key_masked}）` : '已关闭或未设密钥';
    showToast('轻量微摘要配置已保存到本机');
    if (STATE.view === 'atlas' && STATE.topicId !== 'ALL') renderBatchStageOnly();
  };
  window.__onMicroSummaryResult = function(res) {
    if (res.ok && res.hash && res.summary) {
      BATCH_DIFF_CACHE[res.hash] = res.summary;
      const el = document.getElementById('diffTxt_' + res.hash);
      if (el) el.textContent = res.summary;
      const btn = document.getElementById('aiBtn_' + res.hash);
      if (btn) btn.outerHTML = `<span class="meta-caption" style="font-size:12px;color:var(--fresh-ink);font-weight:700;flex-shrink:0;">AI已精炼</span>`;
      showToast(res.cached ? '已命中本地缓存微摘要（0 费用）' : '已生成极简改动摘要并永久缓存');
    } else {
      showToast(res.error || '微摘要调用未启用');
      const btn = document.getElementById('aiBtn_' + res.hash);
      if (btn) { btn.textContent = 'AI 精炼'; btn.disabled = false; }
    }
  };
  window.__onExportResult = function(res) { showToast(res.message || (res.ok ? '打包完成' : '打包失败')); };
  window.__onHostDataUpdated = function(payload) {
    if (payload.hub) HUB = payload.hub;
    if (payload.meta) USER_META = Object.assign(USER_META, payload.meta);
    rebuildFourTierIndex();
    if (STATE.view === 'atlas') renderAtlasOrDrill();
    else switchView(STATE.view);
    if (payload.toast) showToast(payload.toast);
  };

  // =========================================================
  // BOOTSTRAP
  // =========================================================
  async function boot() {
    try {
      const [stRes, infoRes, cacheRes] = await Promise.all([
        fetch('https://hub.local/api/state'),
        fetch('https://hub.local/api/app-info').catch(() => null),
        fetch('https://hub.local/api/batch-cache').catch(() => null)
      ]);
      const payload = await stRes.json();
      HUB = payload.hub;
      if (payload.meta) USER_META = Object.assign(USER_META, payload.meta);
      if (infoRes && infoRes.ok) APP_INFO = await infoRes.json();
      if (cacheRes && cacheRes.ok) BATCH_DIFF_CACHE = await cacheRes.json();
    } catch (_) {}

    rebuildFourTierIndex();

    if (USER_META.ui_gen !== 5) {
      USER_META.ui_gen = 5;
      USER_META.ui_paradigm = 'peach';
      USER_META.ui_scale = 'normal';
      if (!USER_META.ui_font) USER_META.ui_font = 'default';
      persistUiPrefs();
    }

    const params = new URLSearchParams(location.search);
    const initParadigm = params.get('paradigm') || USER_META.ui_paradigm || 'peach';
    const initScale = params.get('scale') || USER_META.ui_scale || 'normal';
    const initFont = params.get('font') || USER_META.ui_font || 'default';
    const initView = params.get('view') || 'atlas';
    const autoTopic = params.get('autotopic') === '1';
    const autoCompare = params.get('autocompare') === '1';

    setParadigm(initParadigm, true);
    setFontScale(initScale, true);
    setFontFamily(initFont, true);

    if (autoTopic && HUB && HUB.topics && HUB.topics.length) {
      // Pick rich topic with multi-round Fig iterations for showcase
      const rich = HUB.topics.find(t => (t.a4_pdf_count || 0) >= 6 && TOPIC_TREE_V4[t.id]?.figs.some(f => f.visualPool.length >= 2))
        || HUB.topics.find(t => t.project_count > 0)
        || HUB.topics[0];
      if (rich) {
        const bestFig = TOPIC_TREE_V4[rich.id].figs.find(f => f.figOrder >= 1 && f.figOrder < 90 && f.visualPool.length >= 2)
          || TOPIC_TREE_V4[rich.id].figs[0];
        STATE.topicId = rich.id;
        STATE.figGroup = bestFig ? bestFig.figGroup : '';
      }
    }

    switchView(initView);

    if (autoCompare && STATE.topicId !== 'ALL') {
      setTimeout(() => openCompareForCurrentFig(), 180);
    }

    // Non-blocking background update check (skip during headless preview capture)
    if (!params.get('paradigm')) {
      setTimeout(() => checkGithubUpdate(false), 2600);
    }

    window.__DESIGN_READY = true;
  }

  boot();
</script>
</body>
</html>
